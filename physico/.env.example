# Server & Environment
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://physio_user:physio_pass@localhost:5432/physioedvance_db?schema=public

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Authentication & Refresh Token Secrets
JWT_SECRET=super_secret_jwt_access_key_physioedvance_2026
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_physioedvance_2026
JWT_REFRESH_EXPIRATION=7d

# Face Verification Engine Configuration
FACE_VERIFICATION_PROVIDER=mock # Options: mock | aws_rekognition | custom_server
FACE_SIMILARITY_THRESHOLD=0.82
FACE_LIVENESS_STRICTNESS=high

# AWS S3 Storage Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=physioedvance-media-assets

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_physioedvance123
RAZORPAY_KEY_SECRET=rzp_secret_physioedvance456

# Zoom Integration Credentials
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_ACCOUNT_ID=your_zoom_account_id

# Notification Service Providers (Email & SMS)
EMAIL_PROVIDER=smtp # Options: smtp | ses | sendgrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@physioedvance.com
SMTP_PASS=your_smtp_password
SMS_PROVIDER=twilio # Options: twilio | msg91
SMS_API_KEY=your_sms_api_key

# AI Chatbot LLM Integration
AI_PROVIDER=openai # Options: openai | gemini | custom
AI_API_KEY=your_ai_api_key
