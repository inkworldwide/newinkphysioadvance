<!-- ============ UNIFIED ROYAL GRADIENT HERO BANNER ============ -->
<section class="pe-hero-strip position-relative py-5 text-white overflow-hidden text-center" style="background: linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%);">
  <div class="container position-relative z-2 py-3">
    <span class="badge bg-warning text-dark font-weight-bold text-uppercase px-3.5 py-2 rounded-pill mb-3 shadow-sm" style="font-size: 0.8rem; letter-spacing: 0.05em; background-color: #f59e0b !important;">
      <i class="ri-compass-3-line me-1"></i> Course Catalog & Digital Library
    </span>
    <h1 class="display-4 font-weight-bold text-white mb-2" style="letter-spacing: -0.02em;">
      Explore Subjects & Courses
    </h1>
    <p class="text-white-75 lead mx-auto mb-0" style="font-size: 1.1rem; line-height: 1.6; max-width: 680px;">
      Browse <%= courses.length %> course<%= courses.length !== 1 ? 's' : '' %> across Anatomy, Physiology, Pathology, Pharmacology, Microbiology, and exam-prep tracks.
    </p>
  </div>
</section>

<section class="pe-section bg-light-subtle py-5">
  <div class="container">
    <div class="row g-4">
      <!-- Filters sidebar -->
      <div class="col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
          <form method="GET" action="/courses">
            <h6 class="fw-bold text-dark mb-3"><i class="ri-search-line me-1 text-primary"></i> Search</h6>
            <input type="text" name="search" class="form-control form-control-lg mb-4 bg-light border-0" placeholder="Search courses..." value="<%= filters.search %>" style="font-size: 0.9rem;">

            <h6 class="fw-bold text-dark mb-3"><i class="ri-book-open-line me-1 text-primary"></i> Subject</h6>
            <div class="d-flex flex-column gap-2 mb-4">
              <label class="d-flex align-items-center gap-2 small fw-semibold text-dark">
                <input type="radio" name="category" value="" <%= !filters.category ? 'checked' : '' %> onchange="this.form.submit()"> All Subjects
              </label>
              <% categories.forEach(cat => { %>
                <label class="d-flex align-items-center gap-2 small text-secondary">
                  <input type="radio" name="category" value="<%= cat.slug %>" <%= filters.category === cat.slug ? 'checked' : '' %> onchange="this.form.submit()">
                  <%= cat.name %> <span class="text-muted small">(<%= cat.course_count %>)</span>
                </label>
              <% }) %>
            </div>

            <h6 class="fw-bold text-dark mb-3"><i class="ri-signal-tower-line me-1 text-primary"></i> Level</h6>
            <div class="d-flex flex-column gap-2 mb-4">
              <% ['Beginner','Intermediate','Advanced'].forEach(lvl => { %>
                <label class="d-flex align-items-center gap-2 small text-secondary">
                  <input type="radio" name="level" value="<%= lvl %>" <%= filters.level === lvl ? 'checked' : '' %> onchange="this.form.submit()"> <%= lvl %>
                </label>
              <% }) %>
              <label class="d-flex align-items-center gap-2 small text-secondary">
                <input type="radio" name="level" value="" <%= !filters.level ? 'checked' : '' %> onchange="this.form.submit()"> Any Level
              </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-pill font-weight-bold shadow-sm" style="background: linear-gradient(135deg, #0a5dc2 0%, #0369a1 100%); border: none;">
              Apply Filters
            </button>
          </form>
        </div>
      </div>

      <!-- Course list -->
      <div class="col-lg-9">
        <% if (courses.length === 0) { %>
          <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
            <div class="my-3">
              <i class="ri-book-open-line display-4 text-muted"></i>
            </div>
            <h5 class="fw-bold text-dark">No courses found matching your filter criteria.</h5>
            <p class="text-muted small">Try adjusting your search terms or clearing the subject filters.</p>
            <div class="mt-2">
              <a href="/courses" class="btn btn-outline-primary rounded-pill px-4">Reset Filters</a>
            </div>
          </div>
        <% } %>

        <div class="row g-4">
          <% courses.forEach(c => { %>
            <div class="col-md-6 col-xl-4">
              <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white transition-all pe-course-card">
                <img src="<%= c.thumbnail || '/images/courses/default-course.jpg' %>" alt="<%= c.title %>" class="card-img-top" style="height: 180px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=600&auto=format&fit=crop&q=80'">
                <div class="card-body p-4 d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-primary-subtle text-primary font-weight-bold px-2.5 py-1 rounded-pill small">
                      <%= c.category_name %>
                    </span>
                    <span class="badge bg-light text-muted border px-2 py-1 rounded-pill small">
                      <%= c.level %>
                    </span>
                  </div>
                  <h6 class="fw-bold text-dark mb-2" style="line-height: 1.4;"><%= c.title %></h6>
                  <p class="text-secondary small mb-3 line-clamp-2" style="font-size: 0.85rem;"><%= c.excerpt || c.description %></p>
                  
                  <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                    <span class="badge bg-success-subtle text-success font-weight-bold px-3 py-1.5 rounded-pill">
                      100% Free Access
                    </span>
                    <a href="/subjects/<%= c.category_slug || c.slug %>" class="btn btn-sm btn-primary rounded-pill px-3 font-weight-bold" style="background: #0a5dc2; border-color: #0a5dc2;">
                      View Subject Portal <i class="ri-arrow-right-line ms-1"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>
