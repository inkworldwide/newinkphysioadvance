<section class="pe-hero-strip">
  <div class="container">
    <span class="pe-hero-eyebrow"><i class="ri-compass-3-line"></i> Explore</span>
    <h1 class="mb-2 mt-2">Explore Subjects &amp; Courses</h1>
    <p class="mb-0">Browse <%= courses.length %> course<%= courses.length !== 1 ? 's' : '' %> across Anatomy, Physiology, Pathology, Pharmacology, Microbiology and exam-prep tracks.</p>
  </div>
</section>

<section class="pe-section">
  <div class="container">
    <div class="row g-4">
      <!-- Filters sidebar -->
      <div class="col-lg-3">
        <div class="card p-3">
          <form method="GET" action="/courses">
            <h6 class="mb-3">Search</h6>
            <input type="text" name="search" class="form-control mb-4" placeholder="Search courses..." value="<%= filters.search %>">

            <h6 class="mb-3">Subject</h6>
            <div class="d-flex flex-column gap-2 mb-4">
              <label class="d-flex align-items-center gap-2 small">
                <input type="radio" name="category" value="" <%= !filters.category ? 'checked' : '' %> onchange="this.form.submit()"> All Subjects
              </label>
              <% categories.forEach(cat => { %>
                <label class="d-flex align-items-center gap-2 small">
                  <input type="radio" name="category" value="<%= cat.slug %>" <%= filters.category === cat.slug ? 'checked' : '' %> onchange="this.form.submit()">
                  <%= cat.name %> <span class="text-muted-pe">(<%= cat.course_count %>)</span>
                </label>
              <% }) %>
            </div>

            <h6 class="mb-3">Level</h6>
            <div class="d-flex flex-column gap-2 mb-4">
              <% ['Beginner','Intermediate','Advanced'].forEach(lvl => { %>
                <label class="d-flex align-items-center gap-2 small">
                  <input type="radio" name="level" value="<%= lvl %>" <%= filters.level === lvl ? 'checked' : '' %> onchange="this.form.submit()"> <%= lvl %>
                </label>
              <% }) %>
              <label class="d-flex align-items-center gap-2 small">
                <input type="radio" name="level" value="" <%= !filters.level ? 'checked' : '' %> onchange="this.form.submit()"> Any Level
              </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-sm">Apply Filters</button>
            <a href="/courses" class="btn btn-outline-primary w-100 btn-sm mt-2">Clear All</a>
          </form>
        </div>
      </div>

      <!-- Course grid -->
      <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <span class="text-muted-pe small"><%= courses.length %> result<%= courses.length !== 1 ? 's' : '' %></span>
          <form method="GET" action="/courses" class="d-flex align-items-center gap-2">
            <input type="hidden" name="category" value="<%= filters.category %>">
            <input type="hidden" name="search" value="<%= filters.search %>">
            <input type="hidden" name="level" value="<%= filters.level %>">
            <label class="small text-muted-pe mb-0">Sort:</label>
            <select name="sort" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
              <option value="" <%= !filters.sort ? 'selected':'' %>>Newest</option>
              <option value="popular" <%= filters.sort==='popular'?'selected':'' %>>Most Popular</option>
              <option value="rating" <%= filters.sort==='rating'?'selected':'' %>>Highest Rated</option>
              <option value="price_low" <%= filters.sort==='price_low'?'selected':'' %>>Price: Low to High</option>
              <option value="price_high" <%= filters.sort==='price_high'?'selected':'' %>>Price: High to Low</option>
            </select>
          </form>
        </div>

        <% if (courses.length === 0) { %>
          <div class="text-center py-5">
            <i class="ri-search-line" style="font-size:3rem; color:var(--pe-text-muted);"></i>
            <h5 class="mt-3">No courses found</h5>
            <p class="text-muted-pe">Try adjusting your filters or search term.</p>
          </div>
        <% } else { %>
          <div class="row g-4">
            <% courses.forEach(course => { %>
              <div class="col-md-6">
                <a href="/courses/<%= course.slug %>" class="text-decoration-none d-block h-100">
                  <div class="pe-fc-card">
                    <div class="pe-fc-thumb">
                      <div class="pe-fc-thumb-bg"></div>
                      <span class="pe-fc-level"><%= course.level %></span>
                      <div class="pe-fc-play-icon"><i class="ri-play-circle-fill"></i></div>
                    </div>
                    <div class="pe-fc-body">
                      <span class="pe-fc-cat"><%= course.category_name || 'General' %></span>
                      <h5 class="pe-fc-title"><%= course.title %></h5>
                      <div class="pe-fc-instructor"><i class="ri-user-3-line"></i> <%= course.instructor_name %></div>
                      <div class="pe-fc-meta">
                        <span><i class="ri-star-fill"></i> <%= course.rating_avg.toFixed(1) %> <span class="text-muted-pe">(<%= course.rating_count %>)</span></span>
                        <span><i class="ri-time-line"></i> <%= course.duration_hours %>h</span>
                      </div>
                    </div>
                    <div class="pe-fc-footer">
                      <span class="pe-fc-free"><i class="ri-gift-line"></i> Free</span>
                      <span class="badge badge-soft-primary"><%= course.target_exam %></span>
                    </div>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
