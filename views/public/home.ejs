              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold text-dark small">
                    <i class="ri-phone-line text-primary me-1"></i> Phone Number
                  </label>
                  <input type="tel" name="phone" class="form-control form-control-lg bg-light-subtle border-light-subtle" placeholder="+91 9XXXXXXXXX" required>
                </div>
