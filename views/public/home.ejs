<!-- ============ HERO BANNER — Ultra-Modern Premium Style ============ -->
<section class="pe-promo-banner">
  <div class="container position-relative z-2">
    <div class="row align-items-center g-4 py-3 py-lg-4">
      <!-- Left Column: Headline, 5 Key Offerings, CTAs, Search -->
      <div class="col-lg-6">
        <div class="pe-hero-content-box">
          <span class="badge bg-warning text-dark font-weight-bold text-uppercase px-3.5 py-2 rounded-pill mb-3 shadow-sm d-inline-flex align-items-center" style="font-size: 0.8rem; letter-spacing: 0.05em; background-color: #f59e0b !important;">
            <i class="ri-heart-pulse-fill me-1"></i> #1 Platform for BPT Students & Physios
          </span>
          <h1 class="pe-hero-title">
            Advanced Physiotherapy Education, <span class="pe-gradient-text">All in One Place.</span>
          </h1>
          <p class="pe-hero-subtext">
            Master your BPT degree with expert-led <strong>Seminars</strong>, HD <strong>Recorded Videos</strong>, interactive <strong>Workshops</strong>, real-time <strong>Live Classes</strong>, and 100% <strong>Free Courses</strong>.
          </p>



          <!-- CTAs -->
          <div class="d-flex gap-3 flex-wrap align-items-center mb-4">
            <a href="/courses" class="btn btn-primary btn-lg pe-btn-glow px-4">
              <i class="ri-compass-3-line me-1"></i> Explore Courses
            </a>
            <a href="/live-sessions" class="btn btn-outline-light btn-lg px-4">
              <i class="ri-calendar-event-line me-1"></i> Join Live Sessions
            </a>
          </div>

          <!-- Search bar -->
          <form action="/courses" method="GET" class="pe-promo-search">
            <i class="ri-search-line me-2 text-primary" style="font-size: 1.2rem;"></i>
            <input type="text" name="search" placeholder="Search Seminars, Workshops, Anatomy, Neuro...">
            <button type="submit">
              Search <i class="ri-arrow-right-line ms-1"></i>
            </button>
          </form>
        </div>
      </div>

      <!-- Right Column: Visual Image Showcase -->
      <div class="col-lg-6 position-relative">
        <div class="pe-hero-visual-wrapper">
          <!-- Main Hero Image with Frame -->
          <div class="pe-hero-img-container">
            <img src="/images/hero_physio_education.jpg" alt="Physiotherapy Education & Clinical Workshop" class="pe-hero-main-img img-fluid">
            <div class="pe-hero-img-overlay"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Dynamic Hero Feature Cards Strip (Managed from Admin Dashboard) -->
    <% if (typeof heroFeatures !== 'undefined' && heroFeatures.length > 0) { %>
      <div class="pe-hero-features-grid mt-4 pt-2">
        <div class="row g-3">
          <% heroFeatures.forEach(feat => { %>
            <div class="col-6 col-md">
              <a href="<%= feat.url || '/courses' %>" class="pe-feature-card">
                <div class="pe-feature-icon bg-<%= feat.badge_color || 'primary' %>-subtle text-<%= feat.badge_color || 'primary' %>">
                  <i class="<%= feat.icon || 'ri-star-line' %>"></i>
                </div>
                <div>
                  <div class="pe-feature-title"><%= feat.title %></div>
                  <div class="pe-feature-desc font-weight-bold text-dark"><%= feat.subtitle %></div>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>


<!-- ============ PRESENT COURSES SLIDER TICKER ============ -->
<section class="pe-therapy-slider-section">
  <div class="container-fluid px-0">
    <div class="pe-therapy-slider">
      <div class="pe-therapy-track">
        <% 
          const coursesToDisplay = (typeof activeCourses !== 'undefined' && activeCourses.length > 0) ? activeCourses : featured;
          const tickerCourses = coursesToDisplay.concat(coursesToDisplay).concat(coursesToDisplay); 
        %>
        <% tickerCourses.forEach(course => { %>
          <a href="/courses/<%= course.slug %>" class="pe-therapy-pill" title="View <%= course.title %>">
            <i class="ri-book-read-line me-1 text-warning"></i>
            <span><%= course.title %></span>
            <% if (course.category_name) { %>
              <span class="badge bg-white text-primary ms-1" style="font-size:0.65rem;"><%= course.category_name %></span>
            <% } %>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<!-- ============ PHYSIOTHERAPY CLINICAL SERVICES ============ -->
<section class="pe-section bg-light-subtle position-relative py-5">
  <div class="container py-2">
    <div class="text-center mb-5">
      <span class="pe-eyebrow">Services</span>
      <h2 class="pe-section-title">What We Focus On</h2>
      <p class="pe-section-sub mx-auto">Every subject, workshop, and course on PhysioEdvance maps directly back to real clinical specialties you'll practice in.</p>
    </div>

    <div class="row g-4">
      <% specialties.forEach(s => { %>
        <div class="col-md-6 col-lg-4">
          <div class="pe-clinical-card pe-theme-<%= s.theme || 'primary' %>">
            <div class="pe-clinical-card-header d-flex justify-content-between align-items-center mb-3">
              <div class="pe-clinical-icon-badge bg-<%= s.theme || 'primary' %>-subtle text-<%= s.theme || 'primary' %>">
                <i class="<%= s.icon %>"></i>
              </div>
              <div class="d-flex align-items-center gap-2">
                <span class="badge bg-<%= s.theme || 'primary' %>-subtle text-<%= s.theme || 'primary' %> fw-bold px-3 py-1 rounded-pill small">
                  <%= s.badge || 'Clinical' %>
                </span>
                <a href="/subjects/<%= s.slug %>" class="pe-clinical-arrow-btn" title="Explore <%= s.name %>">
                  <i class="ri-arrow-right-line"></i>
                </a>
              </div>
            </div>

            <h5 class="pe-clinical-title mb-3">
              <a href="/subjects/<%= s.slug %>" class="text-decoration-none text-dark">
                <%= s.name %>
              </a>
            </h5>

            <ul class="pe-clinical-list list-unstyled mb-0">
              <% s.items.forEach(item => { %>
                <li class="pe-clinical-item">
                  <a href="/courses?search=<%= encodeURIComponent(item) %>" class="text-decoration-none">
                    <i class="ri-checkbox-circle-fill text-<%= s.theme || 'primary' %> me-2 fs-6"></i>
                    <span><%= item %></span>
                  </a>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ SUBJECTS BY YEAR EXECUTIVE SECTION ============ -->
<section class="pe-section bg-white py-5">
  <div class="container py-2">
    <div class="text-center mb-5">
      <h2 class="pe-section-title font-weight-bold display-6">Every Year, Every Subject, Covered</h2>
      <p class="pe-section-sub mx-auto text-muted" style="max-width: 680px;">
        From 1st year BPT foundations to 4th year clinical specialties — pick your academic year or elective subject and start learning.
      </p>
    </div>

    <!-- Executive Tab Bar (Single Line Layout) -->
    <ul class="nav nav-pills pe-year-nav-pills justify-content-center align-items-center mb-5 gap-1.5 p-1.5 bg-light rounded-pill border flex-nowrap overflow-auto" id="yearTabs">
      <li class="nav-item">
        <button class="nav-link active px-3.5 py-2 rounded-pill fw-bold text-nowrap" data-bs-toggle="pill" data-bs-target="#year1" type="button">
          <span class="badge bg-primary text-white me-1">1</span> Year 1 Foundation
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-3.5 py-2 rounded-pill fw-bold text-nowrap" data-bs-toggle="pill" data-bs-target="#year2" type="button">
          <span class="badge bg-info text-white me-1">2</span> Year 2 Clinical
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-3.5 py-2 rounded-pill fw-bold text-nowrap" data-bs-toggle="pill" data-bs-target="#year3" type="button">
          <span class="badge bg-warning text-dark me-1">3</span> Year 3 Advanced
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-3.5 py-2 rounded-pill fw-bold text-nowrap" data-bs-toggle="pill" data-bs-target="#year4" type="button">
          <span class="badge bg-danger text-white me-1">4</span> Year 4 Specialty
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-3.5 py-2 rounded-pill fw-bold text-nowrap" data-bs-toggle="pill" data-bs-target="#yearOther" type="button">
          <span class="badge bg-dark text-white me-1">+</span> Other Subjects
        </button>
      </li>
    </ul>

    <!-- Tab Content Panels -->
    <div class="tab-content">
      <% [1,2,3,4].forEach((y, idx) => { %>
        <div class="tab-pane fade <%= idx===0?'show active':'' %>" id="year<%= y %>">
          <div class="row g-4">
            <% (categoriesByYear[y] || []).forEach(cat => { %>
              <div class="col-6 col-md-4 col-lg-3">
                <a href="/subjects/<%= cat.slug %>" class="pe-subject-box text-decoration-none d-block h-100">
                  <div class="pe-subject-box-inner p-4 rounded-4 bg-white border h-100">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                      <div class="pe-subject-icon bg-primary-subtle text-primary fs-3">
                        <i class="<%= cat.icon || 'ri-book-open-line' %>"></i>
                      </div>
                      <span class="pe-subject-arrow-btn">
                        <i class="ri-arrow-right-line"></i>
                      </span>
                    </div>
                    <h6 class="fw-bold text-dark mb-1 fs-6"><%= cat.name %></h6>
                    <div class="d-flex align-items-center gap-1.5 text-muted small">
                      <i class="ri-checkbox-circle-fill text-success me-1"></i>
                      <span><%= cat.course_count %> course<%= cat.course_count !== 1 ? 's' : '' %> available</span>
                    </div>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>

      <!-- Other Subjects Panel -->
      <div class="tab-pane fade" id="yearOther">
        <div class="row g-4">
          <% otherSubjects.forEach(cat => { %>
            <div class="col-6 col-md-4 col-lg-3">
              <a href="/subjects/<%= cat.slug %>" class="pe-subject-box text-decoration-none d-block h-100">
                <div class="pe-subject-box-inner p-4 rounded-4 bg-white border h-100">
                  <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="pe-subject-icon bg-info-subtle text-info fs-3">
                      <i class="<%= cat.icon || 'ri-book-open-line' %>"></i>
                    </div>
                    <span class="pe-subject-arrow-btn">
                      <i class="ri-arrow-right-line"></i>
                    </span>
                  </div>
                  <h6 class="fw-bold text-dark mb-1 fs-6"><%= cat.name %></h6>
                  <div class="d-flex align-items-center gap-1.5 text-muted small">
                    <i class="ri-checkbox-circle-fill text-success me-1"></i>
                    <span><%= cat.course_count %> course<%= cat.course_count !== 1 ? 's' : '' %> available</span>
                  </div>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FEATURED COURSES ============ -->
<section class="pe-section bg-white">
  <div class="container">
    <div class="d-flex align-items-end justify-content-between mb-4 flex-wrap gap-3">
      <div>
        <span class="pe-eyebrow">Top Rated</span>
        <h2 class="pe-section-title mb-0">Featured Courses</h2>
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#featuredCoursesModal">
          <i class="ri-star-fill text-warning me-1"></i> Display All Featured
        </button>
        <a href="/subjects" class="btn btn-outline-primary btn-sm rounded-pill px-3 ms-1">
          View All Subjects <i class="ri-arrow-right-line"></i>
        </a>
      </div>
    </div>
    <div class="swiper pe-courses-swiper">
      <div class="swiper-wrapper pb-4">
        <% featured.forEach(course => { %>
          <div class="swiper-slide pe-course-slide">
            <a href="/courses/<%= course.slug %>" class="text-decoration-none d-block h-100">
              <div class="pe-fc-card">
                <!-- Thumbnail with gradient overlay -->
                <div class="pe-fc-thumb">
                  <div class="pe-fc-thumb-bg"></div>
                  <span class="pe-fc-level"><%= course.level %></span>
                  <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2 px-2 py-1" style="z-index:3;font-size:0.7rem;"><i class="ri-star-fill me-1"></i>Featured</span>
                  <div class="pe-fc-play-icon"><i class="ri-play-circle-fill"></i></div>
                </div>
                <!-- Card body -->
                <div class="pe-fc-body">
                  <span class="pe-fc-cat"><%= course.category_name || 'General' %></span>
                  <h5 class="pe-fc-title"><%= course.title %></h5>
                  <div class="pe-fc-instructor">
                    <i class="ri-user-3-line"></i> <%= course.instructor_name %>
                  </div>
                  <div class="pe-fc-meta">
                    <span><i class="ri-star-fill"></i> <%= course.rating_avg ? course.rating_avg.toFixed(1) : '4.8' %> <span class="text-muted-pe">(<%= course.rating_count || 50 %>)</span></span>
                    <span><i class="ri-time-line"></i> <%= course.duration_hours || 20 %>h</span>
                  </div>
                </div>
                <!-- Card footer -->
                <div class="pe-fc-footer">
                  <span class="pe-fc-free"><i class="ri-gift-line"></i> Free</span>
                  <span class="badge badge-soft-primary"><%= course.target_exam || 'BPT' %></span>
                </div>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
      <div class="swiper-pagination pe-swiper-pagination mt-2"></div>
      <div class="swiper-button-prev pe-swiper-prev"></div>
      <div class="swiper-button-next pe-swiper-next"></div>
    </div>
  </div>
</section>

<!-- ============ FEATURED COURSES MODAL POP-UP ============ -->
<div class="modal fade" id="featuredCoursesModal" tabindex="-1" aria-labelledby="featuredCoursesModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: hidden;">
      <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #091e3a 0%, #10376d 100%) !important;">
        <div>
          <h4 class="modal-title font-weight-bold d-flex align-items-center gap-2 text-white mb-1" id="featuredCoursesModalLabel">
            <i class="ri-star-fill text-warning"></i> All Featured Courses & Subjects
          </h4>
          <p class="text-white-50 small mb-0">Explore top-rated featured physiotherapy courses and modules built for BPT students.</p>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 bg-light">
        <div class="row g-4">
          <% featured.forEach(course => { %>
            <div class="col-md-6 col-lg-4">
              <a href="/courses/<%= course.slug %>" class="text-decoration-none d-block h-100">
                <div class="pe-fc-card shadow-sm h-100 bg-white" style="border-radius: 16px; overflow: hidden; border: 1px solid #e2e8f0;">
                  <div class="pe-fc-thumb position-relative" style="height: 150px;">
                    <div class="pe-fc-thumb-bg"></div>
                    <span class="pe-fc-level"><%= course.level %></span>
                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2 px-2 py-1" style="z-index:3;font-size:0.7rem;"><i class="ri-star-fill me-1"></i>Featured</span>
                    <div class="pe-fc-play-icon"><i class="ri-play-circle-fill"></i></div>
                  </div>
                  <div class="pe-fc-body p-3">
                    <span class="pe-fc-cat text-primary fw-bold small text-uppercase"><%= course.category_name || 'General' %></span>
                    <h6 class="pe-fc-title fw-bold text-dark mb-2" style="font-size: 0.95rem; line-height: 1.3;"><%= course.title %></h6>
                    <div class="pe-fc-instructor small text-muted mb-2">
                      <i class="ri-user-3-line me-1"></i> <%= course.instructor_name %>
                    </div>
                    <div class="pe-fc-meta small d-flex justify-content-between text-muted">
                      <span><i class="ri-star-fill text-warning me-1"></i> <%= course.rating_avg ? course.rating_avg.toFixed(1) : '4.8' %> (<%= course.rating_count || 50 %>)</span>
                      <span><i class="ri-time-line me-1"></i> <%= course.duration_hours || 20 %>h</span>
                    </div>
                  </div>
                  <div class="pe-fc-footer p-3 bg-white border-top d-flex justify-content-between align-items-center">
                    <span class="text-success fw-bold small"><i class="ri-gift-line me-1"></i> Free</span>
                    <span class="btn btn-sm btn-primary rounded-pill px-3">View Course <i class="ri-arrow-right-line ms-1"></i></span>
                  </div>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
      <div class="modal-footer bg-white border-0 p-3 justify-content-between">
        <span class="text-muted small">Showing <%= featured.length %> Featured Courses</span>
        <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ VISION & MISSION ============ -->
<section class="pe-section">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-6">
        <div class="card p-4 h-100 border-0 shadow-sm rounded-4 bg-white">
          <div class="pe-category-icon mb-3" style="width: 52px; height: 52px; font-size: 1.5rem; background: rgba(10, 93, 194, 0.1); color: #0a5dc2; border-radius: 14px; display: flex; align-items: center; justify-content: center;"><i class="ri-eye-line"></i></div>
          <h5 class="fw-bold text-dark mb-2">Our Vision</h5>
          <p class="text-secondary small mb-0" style="line-height: 1.65;"><%= (typeof visionMission !== 'undefined' && visionMission.vision) ? visionMission.vision : 'To become the one-stop educational destination for physiotherapy students across India — making advanced, clinically-relevant physiotherapy education accessible to every student, regardless of which college they attend.' %></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-4 h-100 border-0 shadow-sm rounded-4 bg-white">
          <div class="pe-category-icon mb-3" style="width: 52px; height: 52px; font-size: 1.5rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 14px; display: flex; align-items: center; justify-content: center;"><i class="ri-flag-line"></i></div>
          <h5 class="fw-bold text-dark mb-2">Our Mission</h5>
          <p class="text-secondary small mb-0" style="line-height: 1.65;"><%= (typeof visionMission !== 'undefined' && visionMission.mission) ? visionMission.mission : '"Help students to help themselves." We build structured notes, digital library content, live discussions, and research resources that empower physiotherapy students to learn independently and confidently, year after year.' %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ CERTIFIED THERAPISTS ============ -->
<% if (founders.length) { %>
<section class="pe-section bg-white overflow-hidden">
  <div class="container">
    <div class="text-center mb-5">
      <span class="pe-section-label"><i class="ri-team-line"></i> Our People</span>
      <h2>Certified Physiotherapists Behind PhysioEdvance</h2>
      <p class="text-muted-pe mx-auto" style="max-width:500px;">Meet the expert team building the future of physiotherapy education in India.</p>
    </div>
    <!-- Static Top 4 Team Members Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 mb-4">
      <% founders.forEach(f => { %>
        <div class="col">
          <div class="pe-team-slide-card h-100 shadow-sm border-0 rounded-4 transition-all bg-white overflow-hidden">
            <div class="pe-team-slide-img-wrap">
              <img src="<%= f.photo %>" alt="<%= f.name %>"
                onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(f.name) %>&background=0a5dc2&color=fff&size=256'">
              <div class="pe-team-slide-overlay">
                <div class="pe-team-slide-bio"><%= f.bio || f.designation %></div>
              </div>
            </div>
            <div class="pe-team-slide-info p-3 text-center">
              <h5 class="mb-0 fw-bold text-dark"><%= f.name %></h5>
              <p class="text-primary-pe small fw-600 mb-0"><%= f.designation %></p>
              <% if (f.qualification) { %><p class="text-muted-pe small mb-0" style="font-size:0.75rem;margin-top:0.2rem;"><%= f.qualification %></p><% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="text-center mt-4">
      <a href="/the-team" class="btn btn-outline-primary btn-lg">Meet the Full Team <i class="ri-arrow-right-line"></i></a>
    </div>
  </div>
</section>
<% } %>

<!-- ============ APPOINTMENT / CALLBACK EXECUTIVE SECTION ============ -->
<section id="appointmentSection" class="pe-section position-relative py-5" style="background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);">
  <div class="container py-3">
    <div class="row g-5 align-items-center">
      <!-- Left Column: Clean Executive Support Box -->
      <div class="col-lg-5">
        <div class="pe-contact-info-wrapper">
          <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-3 py-2 rounded-pill mb-3" style="font-size: 0.75rem; letter-spacing: 0.05em;">
            <i class="ri-phone-find-line me-1"></i> Direct Assistance
          </span>
          <h2 class="fw-bold display-6 mb-3 text-dark" style="letter-spacing: -0.02em; line-height: 1.2;">
            Book an Appointment or Request a Call Back
          </h2>
          <p class="text-secondary leading-relaxed mb-4" style="font-size: 1.05rem;">
            Have questions about BPT subjects, digital library access, upcoming workshops, or live classes? Leave your details and our senior academic advisors will reach out to assist you.
          </p>

          <!-- 2 Executive Support Bullets -->
          <div class="d-flex flex-column gap-3 mb-4">
            <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-3 border-0 shadow-sm">
              <div class="pe-category-icon m-0" style="width: 42px; height: 42px; min-width: 42px; font-size: 1.2rem; background: rgba(10, 93, 194, 0.1); color: #0a5dc2; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                <i class="ri-user-headset-line"></i>
              </div>
              <div>
                <h6 class="fw-bold text-dark mb-0 fs-6">Expert Faculty Guidance</h6>
                <small class="text-muted">Speak directly with experienced BPT educators.</small>
              </div>
            </div>

            <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-3 border-0 shadow-sm">
              <div class="pe-category-icon m-0" style="width: 42px; height: 42px; min-width: 42px; font-size: 1.2rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                <i class="ri-shield-check-line"></i>
              </div>
              <div>
                <h6 class="fw-bold text-dark mb-0 fs-6">Fast 24-Hour Response</h6>
                <small class="text-muted">Our academic advisors call back within one business day.</small>
              </div>
            </div>
          </div>

