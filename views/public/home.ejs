                  </label>
                  <select id="interestCategorySelect" class="form-select form-select-lg bg-light-subtle border-light-subtle" style="font-size: 0.95rem;" onchange="updateDynamicDropdownOptions()">
                    <option value="services" selected>🏥 Clinical Services</option>
                    <option value="courses">🎓 Year / Academic Courses</option>
                  </select>
                </div>

                <!-- Right Field: Dynamic Option Dropdown -->
                <div class="col-md-6">
                  <label class="form-label fw-bold text-dark small" id="dynamicDropdownLabel">
                    <i class="ri-heart-pulse-line text-primary me-1"></i> Select Clinical Service
                  </label>
                  <select name="service_type" id="dynamicOptionSelect" class="form-select form-select-lg bg-light-subtle border-light-subtle" style="font-size: 0.95rem;">
                    <!-- Dynamically populated via JS -->
                  </select>
                </div>
              </div>

              <!-- Dynamic Dropdown Option Switcher Script -->
              <script>
                const clinicalServicesOptions = [
                  { value: "Post-Surgery Physiotherapy", text: "Post-Surgery Physiotherapy" },
                  { value: "Orthopedic & Joint Rehabilitation", text: "Orthopedic & Joint Rehabilitation" },
                  { value: "Neurological Rehabilitation (Stroke / TBI)", text: "Neurological Rehabilitation (Stroke / TBI)" },
                  { value: "Sports Injury & Athletic Conditioning", text: "Sports Injury & Athletic Conditioning" },
                  { value: "Cardiorespiratory ICU & Pulmonary Therapy", text: "Cardiorespiratory ICU & Pulmonary Therapy" },
                  { value: "Pediatric & Geriatric Physical Therapy", text: "Pediatric & Geriatric Physical Therapy" },
                  { value: "Clinical Internship & Practical Guidance", text: "Clinical Internship & Practical Guidance" },
                  { value: "General Physiotherapy Consultation", text: "General Physiotherapy Consultation" }
                ];

                const academicCoursesOptions = [
                  { value: "Year 1 (Foundation & Human Osteology)", text: "Year 1 (Foundation & Human Osteology)" },
                  { value: "Year 2 (Pathology & Biomechanics)", text: "Year 2 (Pathology & Biomechanics)" },
                  { value: "Year 3 (Medicine, Surgery & Ortho)", text: "Year 3 (Medicine, Surgery & Ortho)" },
                  { value: "Year 4 (Neurology, Sports & Rehab)", text: "Year 4 (Neurology, Sports & Rehab)" },
                  { value: "MPT Master Specialty Courses", text: "MPT Master Specialty Courses" },
                  { value: "Competitive Exam Prep (NPTE / GPAT)", text: "Competitive Exam Prep (NPTE / GPAT)" }
                ];

                function updateDynamicDropdownOptions() {
                  const categorySelect = document.getElementById('interestCategorySelect');
                  const targetSelect = document.getElementById('dynamicOptionSelect');
                  const labelElement = document.getElementById('dynamicDropdownLabel');
                  
                  if (!categorySelect || !targetSelect) return;
                  
                  const selectedCategory = categorySelect.value;
                  targetSelect.innerHTML = '';

                  if (selectedCategory === 'services') {
                    labelElement.innerHTML = '<i class="ri-heart-pulse-line text-primary me-1"></i> Select Clinical Service';
                    clinicalServicesOptions.forEach(opt => {
                      const option = document.createElement('option');
                      option.value = opt.value;
                      option.textContent = opt.text;
                      targetSelect.appendChild(option);
                    });
                  } else {
                    labelElement.innerHTML = '<i class="ri-graduation-cap-line text-primary me-1"></i> Select Academic Year / Course';
                    academicCoursesOptions.forEach(opt => {
                      const option = document.createElement('option');
                      option.value = opt.value;
                      option.textContent = opt.text;
                      targetSelect.appendChild(option);
                    });
                  }
                }

                // Initial populate on load
                document.addEventListener('DOMContentLoaded', updateDynamicDropdownOptions);
              </script>

