          <!-- Top Accent Gradient Line -->
          <div style="height: 5px; background: linear-gradient(90deg, #0a5dc2 0%, #38bdf8 100%);"></div>

          <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <div>
                <h4 class="fw-bold text-dark mb-1">Leave Your Details</h4>
                <p class="text-muted small mb-0">Fill out the quick form — we'll handle the rest.</p>
              </div>
