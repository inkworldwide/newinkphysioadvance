<section class="pe-section text-center">
  <div class="container">
    <i class="ri-error-warning-line" style="font-size:5rem; color:var(--pe-danger);"></i>
    <h1 class="mt-3">Something went wrong</h1>
    <p class="text-muted-pe mb-4">We hit an unexpected error. Please try again in a moment.</p>
    <a href="/" class="btn btn-primary">Back to Home</a>
    <% if (typeof error !== 'undefined' && error) { %>
      <pre class="text-start small bg-light p-3 mt-4 rounded"><%= error.stack %></pre>
    <% } %>
  </div>
</section>
