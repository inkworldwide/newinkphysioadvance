<section class="pe-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <a href="/blog" class="small text-muted-pe"><i class="ri-arrow-left-line"></i> Back to Blog</a>
        <span class="badge badge-soft-primary mt-3 mb-2 text-capitalize" style="width:fit-content;"><%= post.post_type %></span>
        <h1 class="pe-section-title"><%= post.title %></h1>
        <div class="text-muted-pe small mb-4">by <%= post.author_name || 'PhysioEdvance' %> &middot; <%= new Date(post.published_at || post.created_at).toLocaleDateString() %></div>
        <div class="pe-article-content"><%- post.content %></div>
      </div>
    </div>
  </div>
</section>
