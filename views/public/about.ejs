<!-- ============ EXECUTIVE HERO BANNER ============ -->
<section class="pe-about-hero position-relative py-5 text-center text-white overflow-hidden" style="background: linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%);">
  <div class="position-absolute end-0 bottom-0 opacity-10 pe-none me-4 mb-2">
    <i class="ri-heart-pulse-fill" style="font-size: 14rem; color: #ffffff;"></i>
  </div>

  <div class="container position-relative z-2 py-4">
    <span class="badge bg-warning text-dark font-weight-bold text-uppercase px-3.5 py-2 rounded-pill mb-3 shadow-sm" style="font-size: 0.8rem; letter-spacing: 0.05em;">
      <i class="ri-heart-pulse-fill me-1"></i> Empowering the Next Generation of Physiotherapists
    </span>

    <h1 class="display-4 font-weight-bold text-white mb-3" style="letter-spacing: -0.02em;">
      About PhysioEdvance
    </h1>

    <p class="text-white-75 mx-auto lead mb-4" style="max-width: 720px; font-size: 1.15rem; line-height: 1.7;">
      PhysioEdvance is an edtech platform created specifically for physiotherapy students, with a simple vision — to make learning physiotherapy more structured, understandable, practical, and accessible.
    </p>

    <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
      <span class="badge bg-white-20 text-white px-3.5 py-2 rounded-pill font-weight-semibold shadow-sm" style="font-size: 0.85rem;">
        <i class="ri-flashlight-fill text-warning me-1"></i> Learn Physiotherapy. Understand Better. Practice Smarter. Advance Further.
      </span>
    </div>
  </div>
</section>

<!-- ============ DYNAMIC LEADERSHIP & FOUNDER STATEMENTS ============ -->
<% if (typeof aboutStatements !== 'undefined' && aboutStatements.length > 0) { %>
<section class="pe-section bg-light-subtle border-bottom py-5">
  <div class="container py-2">
    <div class="text-center mb-5">
      <span class="badge bg-primary-subtle text-primary font-weight-bold text-uppercase px-3 py-1.5 rounded-pill mb-2" style="font-size: 0.75rem;">
        <i class="ri-user-star-line me-1"></i> Leadership & Philosophy
      </span>
      <h2 class="pe-section-title font-weight-bold display-6 mb-2 text-dark">Leadership Messages</h2>
      <p class="text-muted mx-auto" style="max-width: 600px; font-size: 1.05rem;">
        Insights, philosophy, and learning vision from the leaders building PhysioEdvance.
      </p>
    </div>

    <!-- 3-Column Executive Grid Layout -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center">
      <% aboutStatements.forEach((stmt, sIdx) => { 
        const rawText = stmt.statement || stmt.bio || '';
        const lines = rawText.split(/\n\n+|\n/).map(p => p.trim()).filter(p => p.length > 0);
        
        // Chunk into EXACTLY 4 clean sections
        let sections = [];
        if (lines.length <= 4) {
          sections = lines;
        } else {
          const chunkSize = Math.ceil(lines.length / 4);
          for (let i = 0; i < lines.length; i += chunkSize) {
            sections.push(lines.slice(i, i + chunkSize).join(' '));
          }
          sections = sections.slice(0, 4); // Clamp to 4 sections
        }
      %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm rounded-4 pe-leadership-card transition-all bg-white d-flex flex-column overflow-hidden">
            <!-- Card Executive Top Header Banner -->
            <div class="pe-leadership-banner p-4 text-center text-white position-relative" style="background: linear-gradient(135deg, #0a5dc2 0%, #1572e8 100%);">
              <div class="position-relative d-inline-block mb-2">
                <img src="<%= stmt.photo || '/images/team/default-avatar.png' %>" alt="<%= stmt.name %>" class="rounded-circle border border-4 border-white shadow" style="width: 96px; height: 96px; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(stmt.name) %>&background=0a5dc2&color=fff&size=256'">
                <span class="position-absolute bottom-0 end-0 bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center border border-2 border-white shadow-sm" style="width: 26px; height: 26px; font-size: 0.8rem;" title="Leadership Member">
                  <i class="ri-star-fill"></i>
                </span>
              </div>
              <h5 class="fw-bold text-white mb-1"><%= stmt.name %></h5>
              <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 rounded-pill mb-1 d-inline-block shadow-sm" style="font-size: 0.8rem;">
                <%= stmt.designation || stmt.role %>
              </span>
              <% if (stmt.qualification) { %>
                <div class="text-white-50 small"><%= stmt.qualification %></div>
              <% } %>
            </div>

            <!-- Card Statement Body with 4-Section Side-Scrollable Slider -->
            <div class="card-body p-4 d-flex flex-column justify-content-between flex-grow-1">
              <div class="position-relative">
                <div class="pe-quote-mark mb-2 text-primary opacity-25" style="font-size: 2.2rem; line-height: 1; height: 26px;">
                  <i class="ri-double-quotes-l"></i>
                </div>

                <% if (sections.length > 1) { %>
                  <!-- 4-Section Side-Scrollable Swiper Slider with Fixed Height -->
                  <div class="swiper pe-stmt-swiper pe-stmt-swiper-<%= sIdx %> mb-3" style="height: 190px;">
                    <div class="swiper-wrapper">
                      <% sections.forEach((secText, secIdx) => { %>
                        <div class="swiper-slide d-flex align-items-center">
                          <p class="card-text text-dark font-weight-normal mb-0" style="line-height: 1.65; font-style: italic; font-size: 0.92rem; max-height: 180px; overflow-y: auto;">
                            “<%= secText %>”
                          </p>
                        </div>
                      <% }) %>
                    </div>
                    <!-- Exactly 4 Numbered Bullet Buttons (1, 2, 3, 4) -->
                    <div class="pe-stmt-pagination pe-stmt-pagination-<%= sIdx %> d-flex align-items-center justify-content-center gap-2 mt-2"></div>
                  </div>
                <% } else { %>
                  <!-- Single Section View -->
                  <p class="card-text text-dark font-weight-normal mb-4" style="line-height: 1.65; font-style: italic; font-size: 0.95rem;">
                    “<%= rawText || 'PhysioEdvance aims to be a one-stop learning solution for physiotherapy students.' %>”
                  </p>
                <% } %>
              </div>

              <!-- Card Footer -->
              <div class="border-top pt-3 mt-auto d-flex align-items-center justify-content-between">
                <span class="badge bg-light text-primary border rounded-pill px-3 py-1 font-weight-semibold" style="font-size: 0.75rem;">
                  <i class="ri-shield-check-line me-1 text-primary"></i> Leadership Board
                </span>
                <span class="text-muted small fw-semibold" style="font-size: 0.75rem;">
                  PhysioEdvance
                </span>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.pe-stmt-swiper').forEach(function(el) {
      const pagEl = el.querySelector('.pe-stmt-pagination');
      new Swiper(el, {
        slidesPerView: 1,
        spaceBetween: 15,
        autoplay: { delay: 7000, disableOnInteraction: false },
        pagination: {
          el: pagEl,
          clickable: true,
          renderBullet: function (index, className) {
            return '<span class="' + className + '">' + (index + 1) + '</span>';
          }
        }
      });
    });
  });
</script>
<% } %>

<!-- ============ VISION & MISSION CARDS ============ -->
