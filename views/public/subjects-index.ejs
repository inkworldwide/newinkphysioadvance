<!-- Hero strip -->
<section class="pe-subjects-hero">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <span class="pe-section-label"><i class="ri-book-open-line"></i> Curriculum</span>
        <h1 class="mt-2 mb-2">All Subjects</h1>
        <p class="text-muted-pe mb-0">Browse the complete physiotherapy curriculum — organized year by year, from foundation to specialisation.</p>
      </div>
      <div class="col-lg-5 mt-3 mt-lg-0">
        <form action="/courses" method="GET" class="pe-subjects-search">
          <i class="ri-search-line"></i>
          <input type="text" name="search" placeholder="Search subjects or courses...">
          <button type="submit" class="btn btn-primary btn-sm">Search</button>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Year tabs + cards -->
<section class="pe-section">
  <div class="container">

    <!-- Sticky year filter tabs -->
    <div class="pe-year-tabs mb-5">
      <button class="pe-year-tab active" data-year="all">All Years</button>
      <button class="pe-year-tab" data-year="1">
        <span class="pe-year-num">1</span> Year 1 <small>Foundation</small>
      </button>
      <button class="pe-year-tab" data-year="2">
        <span class="pe-year-num">2</span> Year 2 <small>Core Clinical</small>
      </button>
      <button class="pe-year-tab" data-year="3">
        <span class="pe-year-num">3</span> Year 3 <small>Advanced</small>
      </button>
      <button class="pe-year-tab" data-year="4">
        <span class="pe-year-num">4</span> Year 4 <small>Specialisation</small>
      </button>
      <button class="pe-year-tab" data-year="other">
        <span class="pe-year-num" style="background:var(--pe-text-muted);">+</span> Other Subjects
      </button>
    </div>

    <!-- Year groups -->
    <% [1,2,3,4].forEach(y => { %>
      <% if ((categoriesByYear[y] || []).length) { %>
        <div class="pe-year-group mb-5" data-year-group="<%= y %>">
          <div class="d-flex align-items-center gap-3 mb-4">
            <span class="pe-year-group-badge"><%= y %></span>
            <div>
              <h4 class="mb-0">Year <%= y %> Subjects</h4>
              <p class="text-muted-pe mb-0 small"><%= categoriesByYear[y].length %> subjects</p>
            </div>
          </div>
          <div class="row g-3">
            <% categoriesByYear[y].forEach(cat => { %>
              <div class="col-6 col-md-4 col-lg-3">
                <a href="/subjects/<%= cat.slug %>" class="pe-subj-card text-decoration-none">
                  <div class="pe-subj-card-icon">
                    <i class="<%= cat.icon %>"></i>
                  </div>
                  <div class="pe-subj-card-body">
                    <h6 class="pe-subj-card-name"><%= cat.name %></h6>
                    <span class="pe-subj-card-count">
                      <i class="ri-book-2-line"></i>
                      <%= cat.course_count %> course<%= cat.course_count !== 1 ? 's' : '' %>
                    </span>
                  </div>
                  <div class="pe-subj-card-arrow"><i class="ri-arrow-right-line"></i></div>
                </a>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    <% }) %>

    <% if (otherSubjects.length) { %>
      <div class="pe-year-group" data-year-group="other">
        <div class="d-flex align-items-center gap-3 mb-4">
          <span class="pe-year-group-badge" style="background:var(--pe-text-muted);">+</span>
          <div>
            <h4 class="mb-0">Other / Elective Subjects</h4>
            <p class="text-muted-pe mb-0 small"><%= otherSubjects.length %> subjects</p>
          </div>
        </div>
        <div class="row g-3">
          <% otherSubjects.forEach(cat => { %>
            <div class="col-6 col-md-4 col-lg-3">
              <a href="/subjects/<%= cat.slug %>" class="pe-subj-card text-decoration-none">
                <div class="pe-subj-card-icon" style="background:rgba(107,114,128,.1);color:#6b7280;">
                  <i class="<%= cat.icon %>"></i>
                </div>
                <div class="pe-subj-card-body">
                  <h6 class="pe-subj-card-name"><%= cat.name %></h6>
                  <span class="pe-subj-card-count"><i class="ri-book-2-line"></i> <%= cat.course_count %> course<%= cat.course_count !== 1 ? 's' : '' %></span>
                </div>
                <div class="pe-subj-card-arrow"><i class="ri-arrow-right-line"></i></div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<script>
// Year tab filter
document.querySelectorAll('.pe-year-tab').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.pe-year-tab').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    const year = this.dataset.year;
    document.querySelectorAll('.pe-year-group').forEach(g => {
      g.style.display = (year === 'all' || g.dataset.yearGroup === year) ? '' : 'none';
    });
  });
});
</script>
