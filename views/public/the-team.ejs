<!-- Hero Header -->
<section class="pe-team-hero text-center py-5 text-white" style="background: linear-gradient(135deg, #0a5dc2 0%, #0369a1 100%);">
  <div class="container py-4 text-center">
    <span class="badge bg-warning text-dark font-weight-bold text-uppercase px-3 py-1.5 rounded-pill mb-3" style="font-size: 0.8rem;">
      <i class="ri-team-line me-1"></i> Our Faculty & Staff
    </span>
    <h1 class="text-white fw-bold display-5 mb-3">The Team Behind PhysioEdvance</h1>
    <p class="text-white-75 mx-auto lead" style="max-width:680px; font-size: 1.1rem;">
      Built by experienced educators, subject matter experts, technical advisors, and administrative staff united by one mission —
      <br><em class="fw-bold text-warning">"Help students to help themselves."</em>
    </p>
  </div>
</section>

<!-- 1. Teaching Staff -->
<% if (typeof teachingStaff !== 'undefined' && teachingStaff.length > 0) { %>
<section class="pe-section bg-white py-5">
  <div class="container">
    <div class="pe-section-head text-center mb-5">
      <span class="badge bg-primary-subtle text-primary font-weight-bold px-3 py-1.5 rounded-pill mb-2" style="font-size: 0.8rem;">
        <i class="ri-book-open-line me-1"></i> Academic Faculty
      </span>
      <h2 class="fw-bold text-dark display-6">Teaching Staff</h2>
      <p class="text-muted" style="max-width: 600px; margin: 0 auto;">Professors, clinical instructors, and educators guiding your BPT curriculum.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 justify-content-center">
      <% teachingStaff.forEach(m => { %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white transition-all pe-pro-card">
            <div class="position-relative d-inline-block mx-auto mb-3">
              <img src="<%= m.photo || '/images/team/default-avatar.png' %>" alt="<%= m.name %>" class="rounded-circle border border-3 border-primary shadow-sm" style="width: 110px; height: 110px; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(m.name) %>&background=0a5dc2&color=fff&size=256'">
              <span class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center border border-2 border-white shadow-sm" style="width: 28px; height: 28px; font-size: 0.8rem;" title="Teaching Staff">
                <i class="ri-graduation-cap-fill"></i>
              </span>
            </div>
            <h5 class="fw-bold text-dark mb-1"><%= m.name %></h5>
            <div class="text-primary font-weight-semibold small mb-1"><%= m.designation || 'Instructor' %></div>
            <% if (m.qualification) { %>
              <div class="text-muted small mb-2"><i class="ri-award-line text-warning me-1"></i><%= m.qualification %></div>
            <% } %>
            <% if (m.bio) { %>
              <p class="text-secondary small mb-0 mt-2 line-clamp-2" style="font-size: 0.85rem;"><%= m.bio %></p>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- 2. Experts for All Subjects -->
<% if (typeof subjectExperts !== 'undefined' && subjectExperts.length > 0) { %>
<section class="pe-section bg-light py-5">
  <div class="container">
    <div class="pe-section-head text-center mb-5">
      <span class="badge bg-info-subtle text-info font-weight-bold px-3 py-1.5 rounded-pill mb-2" style="font-size: 0.8rem;">
        <i class="ri-microscope-line me-1"></i> Subject Matter Experts
      </span>
      <h2 class="fw-bold text-dark display-6">Experts for All Subjects</h2>
      <p class="text-muted" style="max-width: 600px; margin: 0 auto;">Specialist clinicians authoring subject notes and practical guides.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 justify-content-center">
      <% subjectExperts.forEach(m => { %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white transition-all pe-pro-card">
            <div class="position-relative d-inline-block mx-auto mb-3">
              <img src="<%= m.photo || '/images/team/default-avatar.png' %>" alt="<%= m.name %>" class="rounded-circle border border-3 border-info shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(m.name) %>&background=0ea5e9&color=fff&size=256'">
              <span class="position-absolute bottom-0 end-0 bg-info text-white rounded-circle d-flex align-items-center justify-content-center border border-2 border-white shadow-sm" style="width: 26px; height: 26px; font-size: 0.75rem;">
                <i class="ri-star-fill"></i>
              </span>
            </div>
            <h5 class="fw-bold text-dark mb-1"><%= m.name %></h5>
            <div class="text-info font-weight-semibold small mb-1"><%= m.designation %></div>
            <% if (m.qualification) { %>
              <div class="text-muted small mb-2"><%= m.qualification %></div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

