<!-- CTA -->
<section class="pe-cta-section py-5 text-center" style="background: linear-gradient(135deg, #0a5dc2 0%, #0369a1 100%);">
  <div class="container py-3">
    <h2 class="pe-cta-title text-white font-weight-bold mb-2">Join the PhysioEdvance Community</h2>
    <p class="pe-cta-sub text-white-75 mb-4">Start learning from India's best physiotherapy educators — free, forever.</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
      <a href="/auth/register" class="btn btn-warning btn-lg rounded-pill px-4 py-2.5 font-weight-bold text-dark shadow-sm">
        <i class="ri-user-add-line me-1"></i> Create Free Account
      </a>
      <a href="/subjects" class="btn btn-outline-light btn-lg rounded-pill px-4 py-2.5 font-weight-bold">
        Explore Subjects <i class="ri-arrow-right-line ms-1"></i>
      </a>
    </div>
  </div>
</section>
