<!-- ============ CONTACT MAIN SECTION ============ -->
<section class="pe-section bg-light-subtle py-5">
  <div class="container py-3">
    <div class="row g-5 align-items-stretch">
      <!-- Left Column: Contact Methods & Support Cards -->
      <div class="col-lg-5 d-flex flex-column justify-content-between">
        <div>
          <span class="badge bg-primary-subtle text-primary font-weight-bold text-uppercase px-3 py-1.5 rounded-pill mb-3" style="font-size: 0.75rem;">
            <i class="ri-map-pin-user-line me-1"></i> Contact Channels
          </span>
          <h2 class="fw-bold text-dark display-6 mb-3" style="letter-spacing: -0.02em;">
            Get Direct Guidance
          </h2>
          <p class="text-muted leading-relaxed mb-4" style="font-size: 1rem;">
            Whether you are a student looking for subject clarification or a faculty member interested in collaborating, we are just a message away.
          </p>

          <!-- Contact Cards Grid -->
          <div class="d-flex flex-column gap-3 mb-4">
            <!-- Email Card -->
            <div class="p-3.5 bg-white rounded-4 border shadow-sm d-flex align-items-center gap-3 transition-all">
              <div class="pe-category-icon m-0 flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.4rem; background: rgba(10, 93, 194, 0.1); color: #0a5dc2; border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                <i class="ri-mail-send-fill"></i>
              </div>
              <div>
                <div class="text-muted small fw-bold text-uppercase mb-0.5" style="letter-spacing: 0.04em;">Official Email</div>
                <a href="mailto:support@physioedvance.com" class="fw-bold text-dark text-decoration-none fs-6">
                  support@physioedvance.com
                </a>
              </div>
            </div>

            <!-- Phone / WhatsApp Card -->
            <div class="p-3.5 bg-white rounded-4 border shadow-sm d-flex align-items-center gap-3 transition-all">
              <div class="pe-category-icon m-0 flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.4rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                <i class="ri-whatsapp-fill"></i>
              </div>
              <div class="flex-grow-1">
                <div class="text-muted small fw-bold text-uppercase mb-0.5" style="letter-spacing: 0.04em;">Phone & WhatsApp</div>
                <div class="fw-bold text-dark fs-6">+91 99643 81417</div>
              </div>
              <a href="https://wa.me/919964381417" target="_blank" rel="noopener" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" title="Open WhatsApp Chat">
                <i class="ri-whatsapp-line me-1"></i> Chat
              </a>
            </div>

            <!-- Office Location Card -->
            <div class="p-3.5 bg-white rounded-4 border shadow-sm d-flex align-items-center gap-3 transition-all">
              <div class="pe-category-icon m-0 flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.4rem; background: rgba(245, 158, 11, 0.1); color: #f59e0b; border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                <i class="ri-building-4-fill"></i>
              </div>
              <div>
                <div class="text-muted small fw-bold text-uppercase mb-0.5" style="letter-spacing: 0.04em;">Academic Desk</div>
                <div class="fw-bold text-dark fs-6">PhysioEdvance Headquarters</div>
                <span class="text-muted small">Bengaluru, Karnataka, India</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Fast Response Guarantee Badge -->
        <div class="p-3.5 bg-primary-subtle rounded-4 border border-primary-subtle text-primary">
          <div class="d-flex align-items-center gap-2 mb-1">
            <i class="ri-shield-check-fill fs-5"></i>
            <span class="fw-bold">Fast 24-Hour Response Guarantee</span>
          </div>
          <p class="small mb-0 opacity-85">
            Our academic advisors respond to all student and faculty inquiries within one business day.
          </p>
        </div>
      </div>

      <!-- Right Column: Executive Contact Form -->
      <div class="col-lg-7">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white h-100" style="box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08) !important;">
          <!-- Top Accent Gradient Line -->
          <div style="height: 5px; background: linear-gradient(90deg, #0a5dc2 0%, #38bdf8 100%);"></div>

          <div class="card-body p-4 p-md-5 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                  <h3 class="fw-bold text-dark mb-1">Send Us a Message</h3>
                  <p class="text-muted small mb-0">Fill in the fields below and we'll connect with you shortly.</p>
                </div>
                <span class="badge bg-light text-secondary border rounded-pill px-3 py-2 small">
                  <i class="ri-lock-2-line me-1 text-primary"></i> 100% Confidential
                </span>
              </div>

              <form action="/contact" method="POST">
                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label fw-bold text-dark small">
                      <i class="ri-user-3-line text-primary me-1"></i> Full Name
                    </label>
                    <input type="text" name="name" class="form-control form-control-lg bg-light-subtle border-light-subtle" placeholder="e.g. Dr. Rahul Sharma" required>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold text-dark small">
                      <i class="ri-mail-line text-primary me-1"></i> Email Address
                    </label>
                    <input type="email" name="email" class="form-control form-control-lg bg-light-subtle border-light-subtle" placeholder="name@example.com" required>
                  </div>
                </div>

                <!-- Dynamic Interest Category & Services / Year/Courses Switcher -->
                <div class="row g-3 mb-3">
                  <!-- Left Field: Category Type Selector -->
                  <div class="col-md-6">
                    <label class="form-label fw-bold text-dark small">
                      <i class="ri-apps-line text-primary me-1"></i> Interest Category
                    </label>
                    <select id="contactInterestCategorySelect" class="form-select form-select-lg bg-light-subtle border-light-subtle" style="font-size: 0.95rem;" onchange="updateContactDropdownOptions()">
                      <option value="services" selected>🏥 Clinical Services</option>
                      <option value="courses">🎓 Year / Academic Courses</option>
                    </select>
                  </div>

                  <!-- Right Field: Dynamic Option Dropdown -->
                  <div class="col-md-6">
                    <label class="form-label fw-bold text-dark small" id="contactDynamicDropdownLabel">
                      <i class="ri-heart-pulse-line text-primary me-1"></i> Select Clinical Service
                    </label>
                    <select name="subject" id="contactDynamicOptionSelect" class="form-select form-select-lg bg-light-subtle border-light-subtle" style="font-size: 0.95rem;">
                      <!-- Dynamically populated via JS -->
                    </select>
                  </div>
                </div>

                <!-- Dynamic Option Switcher Script -->
                <script>
                  const contactClinicalServicesOptions = [
                    { value: "Post-Surgery Physiotherapy", text: "Post-Surgery Physiotherapy" },
                    { value: "Orthopedic & Joint Rehabilitation", text: "Orthopedic & Joint Rehabilitation" },
                    { value: "Neurological Rehabilitation (Stroke / TBI)", text: "Neurological Rehabilitation (Stroke / TBI)" },
                    { value: "Sports Injury & Athletic Conditioning", text: "Sports Injury & Athletic Conditioning" },
                    { value: "Cardiorespiratory ICU & Pulmonary Therapy", text: "Cardiorespiratory ICU & Pulmonary Therapy" },
                    { value: "Pediatric & Geriatric Physical Therapy", text: "Pediatric & Geriatric Physical Therapy" },
                    { value: "Clinical Internship & Practical Guidance", text: "Clinical Internship & Practical Guidance" },
                    { value: "General Physiotherapy Consultation", text: "General Physiotherapy Consultation" }
                  ];

                  const contactAcademicCoursesOptions = [
                    { value: "Year 1 (Foundation & Human Osteology)", text: "Year 1 (Foundation & Human Osteology)" },
                    { value: "Year 2 (Pathology & Biomechanics)", text: "Year 2 (Pathology & Biomechanics)" },
                    { value: "Year 3 (Medicine, Surgery & Ortho)", text: "Year 3 (Medicine, Surgery & Ortho)" },
                    { value: "Year 4 (Neurology, Sports & Rehab)", text: "Year 4 (Neurology, Sports & Rehab)" },
                    { value: "MPT Master Specialty Courses", text: "MPT Master Specialty Courses" },
                    { value: "Research & Biostatistics Desk", text: "Research & Biostatistics Desk" }
                  ];

                  function updateContactDropdownOptions() {
                    const categorySelect = document.getElementById('contactInterestCategorySelect');
                    const targetSelect = document.getElementById('contactDynamicOptionSelect');
                    const label = document.getElementById('contactDynamicDropdownLabel');

                    if (!categorySelect || !targetSelect || !label) return;

                    const selectedCategory = categorySelect.value;
                    targetSelect.innerHTML = '';

                    if (selectedCategory === 'services') {
                      label.innerHTML = '<i class="ri-heart-pulse-line text-primary me-1"></i> Select Clinical Service';
                      contactClinicalServicesOptions.forEach(opt => {
                        const el = document.createElement('option');
                        el.value = opt.value;
                        el.textContent = opt.text;
                        targetSelect.appendChild(el);
                      });
                    } else {
                      label.innerHTML = '<i class="ri-graduation-cap-line text-primary me-1"></i> Select Year / Academic Course';
                      contactAcademicCoursesOptions.forEach(opt => {
                        const el = document.createElement('option');
                        el.value = opt.value;
                        el.textContent = opt.text;
                        targetSelect.appendChild(el);
                      });
                    }
                  }

                  document.addEventListener('DOMContentLoaded', updateContactDropdownOptions);
                </script>

                <div class="mb-4">
                  <label class="form-label fw-bold text-dark small">
                    <i class="ri-message-3-line text-primary me-1"></i> Your Message
                  </label>
                  <textarea name="message" rows="4" class="form-control bg-light-subtle border-light-subtle" placeholder="How can our team help you today? Please provide details..." required></textarea>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-sm" style="background: linear-gradient(135deg, #0a5dc2 0%, #0369a1 100%); border: none;">
                  <i class="ri-send-plane-fill me-1"></i> Send Message Now
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

