<section class="pe-section">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-5">
        <span class="pe-eyebrow">Get in Touch</span>
        <h2 class="pe-section-title">We'd love to hear from you</h2>
        <p class="text-muted-pe mb-4">Questions about a course, partnership ideas, or just feedback — reach out and our team will respond within 24 hours.</p>

        <div class="d-flex gap-3 mb-3">
          <div class="pe-category-icon flex-shrink-0"><i class="ri-mail-line"></i></div>
          <div>
            <h6 class="mb-0">Email</h6>
            <span class="text-muted-pe small">support@physioedvance.com</span>
          </div>
        </div>
        <div class="d-flex gap-3 mb-3">
          <div class="pe-category-icon flex-shrink-0"><i class="ri-phone-line"></i></div>
          <div>
            <h6 class="mb-0">Phone / WhatsApp</h6>
            <span class="text-muted-pe small">+91 99643 81417</span>
          </div>
        </div>
        <div class="d-flex gap-3">
          <div class="pe-category-icon flex-shrink-0"><i class="ri-map-pin-line"></i></div>
          <div>
            <h6 class="mb-0">Office</h6>
            <span class="text-muted-pe small">Address coming soon</span>
          </div>
        </div>
      </div>
      <div class="col-lg-7">
        <div class="card p-4">
          <form action="/contact" method="POST">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input type="text" name="name" class="form-control" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" required>
              </div>
              <div class="col-12">
                <label class="form-label">Subject</label>
                <input type="text" name="subject" class="form-control" required>
              </div>
              <div class="col-12">
                <label class="form-label">Message</label>
                <textarea name="message" rows="5" class="form-control" required></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-primary px-4">Send Message <i class="ri-send-plane-line ms-1"></i></button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
