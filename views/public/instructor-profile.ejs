<section class="pe-course-hero">
  <div class="container">
    <div class="d-flex gap-4 align-items-center flex-wrap">
      <img src="<%= instructor.avatar %>" class="rounded-circle avatar-lg" style="width:6rem;height:6rem;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(instructor.name) %>&background=0a5dc2&color=fff&size=128'">
      <div>
        <h1 class="text-white mb-1" style="font-size:1.75rem;"><%= instructor.name %></h1>
        <p class="text-white-50 mb-2"><%= instructor.headline %></p>
        <span class="badge badge-soft-info"><%= courses.length %> course<%= courses.length !== 1 ? 's' : '' %></span>
      </div>
    </div>
  </div>
</section>

<section class="pe-section">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="card p-4">
          <h6 class="mb-3">About <%= instructor.name.split(' ')[0] %></h6>
          <p class="small text-muted-pe" style="line-height:1.8;"><%= instructor.bio %></p>
          <hr>
          <div class="small text-muted-pe"><i class="ri-graduation-cap-line me-2"></i><%= instructor.qualification %></div>
        </div>
      </div>
      <div class="col-lg-8">
        <h5 class="mb-3">Courses by <%= instructor.name %></h5>
        <div class="row g-4">
          <% courses.forEach(course => { %>
            <div class="col-md-6">
              <a href="/subjects/<%= course.category_slug || course.slug %>" class="text-decoration-none d-block h-100">
                <div class="pe-fc-card">
                  <div class="pe-fc-thumb">
                    <div class="pe-fc-thumb-bg"></div>
                    <span class="pe-fc-level"><%= course.level %></span>
                    <div class="pe-fc-play-icon"><i class="ri-play-circle-fill"></i></div>
                  </div>
                  <div class="pe-fc-body">
                    <span class="pe-fc-cat"><%= course.category_name || 'General' %></span>
                    <h5 class="pe-fc-title"><%= course.title %></h5>
                    <div class="pe-fc-meta">
                      <span><i class="ri-star-fill"></i> <%= course.rating_avg.toFixed(1) %></span>
                      <span><i class="ri-time-line"></i> <%= course.duration_hours %>h</span>
                    </div>
                  </div>
                  <div class="pe-fc-footer">
                    <span class="pe-fc-free"><i class="ri-gift-line"></i> Free</span>
                  </div>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>
