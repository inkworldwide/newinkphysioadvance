<!-- ============ LESSON TOP BAR ============ -->
<section class="pe-lesson-topbar bg-dark text-white py-3 border-bottom border-secondary border-opacity-25">
  <div class="container">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      
      <!-- Breadcrumb -->
      <nav class="pe-breadcrumb" style="font-size: 0.85rem; color: rgba(255,255,255,0.75);">
        <a href="/subjects" class="text-white text-decoration-none"><i class="ri-home-3-line"></i> Subjects</a>
        <i class="ri-arrow-right-s-line mx-1 text-white-50"></i>
        <a href="/subjects/<%= category.slug %>" class="text-white text-decoration-none"><%= category.name %></a>
        <i class="ri-arrow-right-s-line mx-1 text-white-50"></i>
        <a href="/subjects/<%= category.slug %>/course" class="text-warning text-decoration-none"><%= currentModule ? currentModule.title : 'Course' %></a>
      </nav>

      <!-- Lesson Navigation Buttons -->
      <div class="d-flex align-items-center gap-2">
        <% if (prevLesson) { %>
          <a href="/subjects/<%= category.slug %>/lesson/<%= prevLesson.id %>" class="btn btn-sm btn-outline-light rounded-pill px-3 font-weight-bold">
            <i class="ri-arrow-left-line me-1"></i> Previous Lesson
          </a>
        <% } %>

        <button type="button" class="btn btn-sm btn-success rounded-pill px-3.5 font-weight-bold shadow-sm" id="btnMarkComplete" onclick="markLessonComplete('<%= currentLesson.id %>')">
          <i class="ri-checkbox-circle-line me-1"></i> Mark Completed
        </button>

        <% if (nextLesson) { %>
          <a href="/subjects/<%= category.slug %>/lesson/<%= nextLesson.id %>" class="btn btn-sm btn-primary rounded-pill px-3.5 font-weight-bold" style="background: #0a5dc2; border-color: #0a5dc2;">
            Next Lesson <i class="ri-arrow-right-line ms-1"></i>
          </a>
        <% } %>
      </div>

    </div>
  </div>
</section>

<!-- ============ MAIN LESSON LEARNING WORKSPACE ============ -->
<section class="pe-lesson-workspace py-5 bg-light-subtle">
  <div class="container">
    <div class="row g-4">

      <!-- LEFT COLUMN: VIDEO PLAYER & STUDY NOTES -->
      <div class="col-lg-8">
        
        <!-- 🎬 PHYSIOEDVANCE INTERNAL VIDEO PLAYER CONTAINER -->
        <div class="card border-0 rounded-4 overflow-hidden shadow-lg mb-4 bg-dark position-relative" id="peInternalVideoCard">
          
          <!-- Auto-Resume Toast Banner -->
          <div id="resumeToast" class="position-absolute top-0 start-0 end-0 p-3 bg-primary text-white z-3 d-none d-flex align-items-center justify-content-between shadow-sm">
            <span><i class="ri-time-line me-1"></i> Welcome back! Resuming from <strong id="resumeTimeStr">00:00</strong>...</span>
            <button type="button" class="btn-close btn-close-white small" onclick="closeResumeToast()"></button>
          </div>

          <div class="ratio ratio-16x9 bg-dark position-relative">
            <video id="peVideoPlayer" playsinline controls class="w-100 h-100" style="object-fit: cover; background: #020617;">
              <source src="<%= currentLesson.videoUrl %>" type="video/mp4">
              Your browser does not support internal HTML5 video playback.
            </video>
          </div>

          <!-- Video Custom Control Bar -->
          <div class="card-body p-3 bg-dark text-white d-flex align-items-center justify-content-between flex-wrap gap-2 border-top border-secondary border-opacity-25 z-2">
            
            <div class="d-flex align-items-center gap-2">
              <button type="button" class="btn btn-sm btn-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" onclick="seekRelative(-10)">
                <i class="ri-replay-10-line fs-6"></i>
              </button>
              <button type="button" class="btn btn-sm btn-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" onclick="seekRelative(10)">
                <i class="ri-forward-10-line fs-6"></i>
              </button>

              <span class="badge bg-warning text-dark font-weight-bold px-2.5 py-1 rounded-pill small ms-2">
                <i class="ri-shield-check-fill me-1 text-primary"></i> PhysioEdvance Internal Player
              </span>
            </div>

            <!-- Playback Speed Controls -->
            <div class="d-flex align-items-center gap-2">
              <span class="small text-white-75"><i class="ri-speed-line me-1"></i> Speed:</span>
              <select class="form-select form-select-sm bg-dark text-white border-secondary rounded-pill w-auto small" id="speedSelect" onchange="changePlaybackSpeed(this.value)">
                <option value="0.5">0.5x</option>
                <option value="0.75">0.75x</option>
                <option value="1.0" selected>1.0x (Normal)</option>
                <option value="1.25">1.25x</option>
                <option value="1.5">1.5x</option>
                <option value="2.0">2.0x</option>
              </select>
            </div>

          </div>
        </div>

        <!-- Lesson Title & Module Banner -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4 border">
          <span class="badge bg-primary-subtle text-primary font-weight-bold px-3 py-1 rounded-pill w-fit mb-2">
            <%= currentModule ? currentModule.title : 'Module' %>
          </span>
          <h2 class="fw-bold text-dark mb-2"><%= currentLesson.title %></h2>
          <p class="text-secondary leading-relaxed mb-0" style="font-size: 0.98rem;"><%= currentLesson.summary %></p>
        </div>

        <!-- 💡 KEY POINTS HIGHLIGHT BOX -->
        <% if (currentLesson.keyPoints && currentLesson.keyPoints.length > 0) { %>
          <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 border" style="background: linear-gradient(135deg, #fffbe6 0%, #fef3c7 100%); border-left: 5px solid #f59e0b !important;">
            <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
              <i class="ri-lightbulb-fill text-warning fs-4"></i>
              <span class="fs-5">💡 Key Exam & Clinical Points</span>
            </div>
            <ul class="list-unstyled mb-0">
              <% currentLesson.keyPoints.forEach(kp => { %>
                <li class="small text-dark mb-2 d-flex align-items-start fw-medium" style="line-height: 1.6;">
                  <i class="ri-checkbox-circle-fill text-warning me-2 mt-0.5 fs-6"></i> <%= kp %>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <!-- 🏥 CLINICAL RELEVANCE BOX -->
        <% if (currentLesson.clinicalRelevance) { %>
          <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 border" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-left: 5px solid #0284c7 !important;">
            <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
              <i class="ri-stethoscope-fill text-primary fs-4"></i>
              <span class="fs-5">🏥 Physical Therapy Clinical Relevance</span>
            </div>
            <p class="text-dark small mb-0 fw-semibold" style="line-height: 1.6;"><%= currentLesson.clinicalRelevance %></p>
          </div>
        <% } %>

        <!-- COMPLETE STUDY NOTES -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4">
          <h4 class="fw-bold text-dark mb-3 border-bottom pb-2">
            <i class="ri-file-text-line text-primary me-2"></i>Complete Study Notes
          </h4>
          <div class="pe-notes-body text-dark leading-relaxed" style="font-size: 0.96rem; line-height: 1.7;">
            <%- (currentLesson.notesContent || '').replace(/\n/g, '<br>') %>
          </div>
        </div>

        <!-- LESSON SELF-ASSESSMENT QUIZ -->
        <% if (currentLesson.quiz && currentLesson.quiz.length > 0) { %>
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4" id="sec-lesson-quiz">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
              <h4 class="fw-bold text-dark mb-0">
                <i class="ri-question-line text-warning me-2"></i>Lesson Self-Assessment Quiz
              </h4>
              <span class="badge bg-warning-subtle text-dark font-weight-bold px-3 py-1 rounded-pill small">Immediate Feedback</span>
            </div>

            <% currentLesson.quiz.forEach((q, qIdx) => { %>
              <div class="p-3.5 bg-light rounded-4 border mb-3">
                <h6 class="fw-bold text-dark mb-3">Q<%= qIdx + 1 %>: <%= q.question %></h6>
                <div class="d-flex flex-column gap-2 mb-3">
                  <% q.options.forEach((opt, oIdx) => { %>
                    <button type="button" class="btn btn-outline-secondary text-start rounded-pill px-3.5 py-2 font-weight-medium text-dark btn-quiz-opt" onclick="checkQuizAnswer(<%= qIdx %>, <%= oIdx %>, <%= q.answer %>)">
                      <%= String.fromCharCode(65 + oIdx) %>. <%= opt %>
                    </button>
                  <% }) %>
                </div>
                <div id="quizExp-<%= qIdx %>" class="alert alert-info rounded-3 mb-0 d-none small">
                  <strong>Explanation:</strong> <%= q.explanation %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>

      </div>

      <!-- RIGHT COLUMN: COURSE MODULES SIDEBAR NAVIGATION -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border sticky-top" style="top: 90px;">
          <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
            <i class="ri-folder-2-line text-primary me-2"></i>Course Navigation
          </h5>

          <div class="accordion accordion-flush" id="courseNavAccordion">
            <% courseData.modules.forEach((mod, mIdx) => { %>
              <div class="accordion-item border-0 mb-2">
                <h2 class="accordion-header">
                  <button class="accordion-button rounded-3 font-weight-bold small py-2.5 px-3 <%= (currentModule && currentModule.id === mod.id) ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMod-<%= mIdx %>">
                    Module <%= mod.number %>: <%= mod.title %>
                  </button>
                </h2>
                <div id="collapseMod-<%= mIdx %>" class="accordion-collapse collapse <%= (currentModule && currentModule.id === mod.id) ? 'show' : '' %>" data-bs-parent="#courseNavAccordion">
                  <div class="accordion-body p-2">
                    <div class="list-group list-group-flush">
                      <% mod.lessons.forEach((les, lIdx) => { %>
                        <a href="/subjects/<%= category.slug %>/lesson/<%= les.id %>" class="list-group-item list-group-item-action rounded-3 small py-2 px-3 border-0 d-flex align-items-center justify-content-between <%= (currentLesson && currentLesson.id === les.id) ? 'bg-primary text-white font-weight-bold' : '' %>">
                          <span class="line-clamp-1"><%= les.title %></span>
                          <i class="ri-play-circle-line ms-1"></i>
                        </a>
                      <% }) %>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>

          <div class="mt-4 pt-3 border-top text-center">
            <a href="/subjects/<%= category.slug %>/course" class="btn btn-outline-primary rounded-pill w-100 font-weight-bold">
              <i class="ri-dashboard-line me-1"></i> Course Dashboard
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- 🎬 INTERNAL VIDEO PLAYER & PROGRESS SCRIPT -->
<script>
  const videoPlayer = document.getElementById('peVideoPlayer');
  const subjectSlug = '<%= category.slug %>';
  const lessonId = '<%= currentLesson.id %>';
  const storageKey = `watch_pos_${subjectSlug}_${lessonId}`;

  // 1. Auto-Resume from saved position
  document.addEventListener('DOMContentLoaded', () => {
    const savedPos = localStorage.getItem(storageKey);
    if (savedPos && videoPlayer) {
      const posSec = parseFloat(savedPos);
      if (posSec > 5) {
        videoPlayer.currentTime = posSec;
        const mins = Math.floor(posSec / 60);
        const secs = Math.floor(posSec % 60);
        const timeStr = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        
        const toast = document.getElementById('resumeToast');
        document.getElementById('resumeTimeStr').innerText = timeStr;
        if (toast) {
          toast.classList.remove('d-none');
          setTimeout(() => toast.classList.add('d-none'), 5000);
        }
      }
    }
  });

  // 2. Save watch position periodically
  if (videoPlayer) {
    videoPlayer.addEventListener('timeupdate', () => {
      if (videoPlayer.currentTime > 2) {
        localStorage.setItem(storageKey, videoPlayer.currentTime);
      }
      // Auto-mark completed if >90% watched
      if (videoPlayer.duration > 0 && (videoPlayer.currentTime / videoPlayer.duration) > 0.90) {
        markLessonComplete(lessonId);
      }
    });
  }

  function seekRelative(seconds) {
    if (videoPlayer) {
      videoPlayer.currentTime = Math.max(0, Math.min(videoPlayer.duration || 100, videoPlayer.currentTime + seconds));
    }
  }

  function changePlaybackSpeed(speed) {
    if (videoPlayer) {
      videoPlayer.playbackRate = parseFloat(speed);
    }
  }

  function closeResumeToast() {
    const toast = document.getElementById('resumeToast');
    if (toast) toast.classList.add('d-none');
  }

  function markLessonComplete(id) {
    const completed = JSON.parse(localStorage.getItem(`completed_lessons_${subjectSlug}`) || '[]');
    if (!completed.includes(id)) {
      completed.push(id);
      localStorage.setItem(`completed_lessons_${subjectSlug}`, JSON.stringify(completed));
    }
    const btn = document.getElementById('btnMarkComplete');
    if (btn) {
      btn.className = 'btn btn-sm btn-success rounded-pill px-3.5 font-weight-bold shadow-sm';
      btn.innerHTML = '<i class="ri-checkbox-circle-fill me-1"></i> Completed!';
    }
  }

  function checkQuizAnswer(qIdx, oIdx, correctIdx) {
    const expBox = document.getElementById(`quizExp-${qIdx}`);
    if (expBox) expBox.classList.remove('d-none');
  }
</script>
