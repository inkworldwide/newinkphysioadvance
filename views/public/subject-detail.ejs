<!-- Dynamic Grid Card Styling & Interactive WebGL Script -->
<style>
  .pe-neuro-card {
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1) !important;
  }
  .pe-neuro-card:hover {
    transform: translateY(-6px) scale(1.02) !important;
    box-shadow: 0 12px 30px rgba(2, 132, 199, 0.3) !important;
  }
</style>

<!-- Three.js Library for GPU-Accelerated 3D WebGL Organ Rendering -->
<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

<script>
  const hotspotsData = <%- JSON.stringify(interactiveData.hotspots || []) %>;

  function scrollToSection(id) {
    const el = document.getElementById(id);
    if (el) {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function showHotspotInfo(id) {
    const hs = hotspotsData.find(item => item.id === id);
    if (!hs) return;
    document.getElementById('hsId').innerText = hs.id;
    document.getElementById('hsTitle').innerText = hs.title;
    document.getElementById('hsDesc').innerText = hs.description;
    document.getElementById('hsNerve').innerText = hs.nerveSupply;
    document.getElementById('hsAction').innerText = hs.action;
  }

  let labelsVisible = true;
  function toggleAllLabels() {
    labelsVisible = !labelsVisible;
    document.querySelectorAll('.cs-labels-box').forEach(box => {
      box.style.display = labelsVisible ? 'flex' : 'none';
    });
  }

  // ===== THREE.JS 3D WEBGL MEDICAL ENGINE =====
  function init3DMedicalEngine() {
    const canvas = document.getElementById('demo3DCanvas');
    if (!canvas || typeof THREE === 'undefined') return;

    const container = canvas.parentElement;
    const width = container.clientWidth || 400;
    const height = container.clientHeight || 340;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.set(0, 0, 5);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
    scene.add(ambientLight);

    const dirLight1 = new THREE.DirectionalLight(0x0284c7, 1.5);
    dirLight1.position.set(5, 5, 5);
    scene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0xf59e0b, 1.0);
    dirLight2.position.set(-5, -5, -2);
    scene.add(dirLight2);

    // Create 3D Anatomical Organ / Brain Model Group
    const group = new THREE.Group();

    // Central Brain Lobe Mesh (Icosahedron + Smooth Wireframe)
    const brainGeo = new THREE.IcosahedronGeometry(1.4, 3);
    const brainMat = new THREE.MeshStandardMaterial({
      color: 0x0284c7,
      roughness: 0.3,
      metalness: 0.2,
      wireframe: false,
      flatShading: true
    });
    const brainMesh = new THREE.Mesh(brainGeo, brainMat);
    group.add(brainMesh);

    // Glowing Wireframe Outer Layer
    const wireMat = new THREE.MeshBasicMaterial({
      color: 0x38bdf8,
      wireframe: true,
      transparent: true,
      opacity: 0.35
    });
    const wireMesh = new THREE.Mesh(brainGeo, wireMat);
    wireMesh.scale.setScalar(1.04);
    group.add(wireMesh);

    // Surrounding Synaptic Particles
    const particleGeo = new THREE.BufferGeometry();
    const count = 120;
    const positions = new Float32Array(count * 3);
    for (let i = 0; i < count * 3; i++) {
      positions[i] = (Math.random() - 0.5) * 4.5;
    }
    particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const particleMat = new THREE.PointsMaterial({ color: 0xf59e0b, size: 0.05, transparent: true, opacity: 0.8 });
    const particles = new THREE.Points(particleGeo, particleMat);
    group.add(particles);

    scene.add(group);

    // Mouse Drag Controls
    let isDragging = false;
    let previousMousePosition = { x: 0, y: 0 };

    canvas.addEventListener('mousedown', e => {
      isDragging = true;
      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('mouseup', () => isDragging = false);

    canvas.addEventListener('mousemove', e => {
      if (!isDragging) return;
      const deltaX = e.clientX - previousMousePosition.x;
      const deltaY = e.clientY - previousMousePosition.y;

      group.rotation.y += deltaX * 0.01;
      group.rotation.x += deltaY * 0.01;

      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    // Touch Controls
    canvas.addEventListener('touchstart', e => {
      if (e.touches.length === 1) {
        isDragging = true;
        previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      }
    });
    canvas.addEventListener('touchend', () => isDragging = false);
    canvas.addEventListener('touchmove', e => {
      if (!isDragging || e.touches.length !== 1) return;
      const deltaX = e.touches[0].clientX - previousMousePosition.x;
      const deltaY = e.touches[0].clientY - previousMousePosition.y;

      group.rotation.y += deltaX * 0.01;
      group.rotation.x += deltaY * 0.01;

      previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    });

    // Animation Loop
    function animate() {
      requestAnimationFrame(animate);
      if (!isDragging) {
        group.rotation.y += 0.006;
        group.rotation.x += 0.002;
      }
      particles.rotation.y -= 0.003;
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      const w = container.clientWidth || 400;
      const h = container.clientHeight || 340;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    });
  }

  function switchMediaMode(mode) {
    const canvasCont = document.getElementById('demo3DCanvasContainer');
    const videoCont = document.getElementById('demo3DVideoContainer');
    const btn3D = document.getElementById('btnShow3D');
    const btnVid = document.getElementById('btnShowVideo');

    if (mode === 'video') {
      videoCont.classList.remove('d-none');
      canvasCont.classList.add('d-none');
      btnVid.className = 'btn btn-sm btn-primary font-weight-bold';
      btn3D.className = 'btn btn-sm btn-outline-light font-weight-bold';
    } else {
      canvasCont.classList.remove('d-none');
      videoCont.classList.add('d-none');
      btn3D.className = 'btn btn-sm btn-primary font-weight-bold';
      btnVid.className = 'btn btn-sm btn-outline-light font-weight-bold';
    }
  }

  document.addEventListener('DOMContentLoaded', init3DMedicalEngine);
</script>
