<!-- Top Action Header -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
  <div>
    <h4 class="mb-1 fw-bold text-dark"><i class="ri-pulse-line me-2 text-primary"></i>Homepage Clinical Specialties ("What We Focus On")</h4>
    <p class="text-muted small mb-0">Enable/disable, re-order, or add new clinical specialty cards shown on the homepage.</p>
  </div>
  <button type="button" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm font-weight-bold" data-bs-toggle="modal" data-bs-target="#addSpecialtyModal">
    <i class="ri-add-circle-line me-1"></i> Add New Specialty
  </button>
</div>

<!-- Full-Width Clinical Specialties Table -->
<div class="card shadow-sm border-0" style="border-radius: 16px;">
  <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
    <h5 class="mb-0 fw-bold text-dark"><i class="ri-list-check me-2 text-primary"></i>Active & Inactive Specialties List</h5>
    <span class="badge bg-primary text-white rounded-pill px-3 py-2"><%= specialties.length %> Total Specialties</span>
  </div>
  <div class="table-responsive">
    <table class="table pe-table align-middle mb-0">
      <thead class="bg-light">
        <tr>
          <th>Specialty Details</th>
          <th class="text-center">Status</th>
          <th class="text-center">Display Order</th>
          <th>Clinical Items List</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (specialties.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted-pe py-4">No clinical specialties added yet. Click "Add New Specialty" above to create one.</td></tr>
        <% } %>
        <% specialties.forEach(s => { %>
          <tr class="<%= !s.is_active ? 'bg-light opacity-75' : '' %>">
            <td>
              <div class="d-flex align-items-center gap-3">
                <div class="pe-clinical-icon-badge bg-<%= s.theme || 'primary' %>-subtle text-<%= s.theme || 'primary' %> p-2 rounded-3 fs-4" style="width:46px;height:46px;">
                  <i class="<%= s.icon || 'ri-stethoscope-fill' %>"></i>
                </div>
                <div>
                  <div class="fw-bold text-dark fs-6"><%= s.name %></div>
                  <span class="badge bg-<%= s.theme || 'primary' %>-subtle text-<%= s.theme || 'primary' %> small px-2.5 py-0.5 rounded-pill fw-semibold"><%= s.badge || 'Clinical' %></span>
                </div>
              </div>
            </td>
            <td class="text-center">
              <form action="/admin/specialties/<%= s.id %>/toggle" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm rounded-pill px-3 fw-bold <%= s.is_active ? 'btn-success' : 'btn-secondary opacity-75' %>" title="Click to <%= s.is_active ? 'Disable' : 'Enable' %>">
                  <i class="<%= s.is_active ? 'ri-checkbox-circle-line' : 'ri-close-circle-line' %> me-1"></i>
                  <%= s.is_active ? 'Enabled' : 'Disabled' %>
                </button>
              </form>
            </td>
            <td class="text-center">
              <span class="badge bg-light text-primary border px-3 py-1 font-weight-bold">Pos #<%= s.display_order %></span>
            </td>
            <td>
              <div class="small text-muted" style="max-width: 280px;">
                <span class="fw-bold text-dark d-block mb-1"><i class="ri-checkbox-circle-fill text-<%= s.theme || 'primary' %> me-1"></i><%= s.items.length %> Clinical Modules:</span>
                <span class="d-block text-truncate text-muted"><%= s.items.join(', ') %></span>
              </div>
            </td>
            <td class="text-end">
              <div class="d-flex align-items-center justify-content-end gap-2">
                <a href="/admin/specialties/<%= s.id %>/edit" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Edit Specialty">
                  <i class="ri-edit-line me-1"></i> Edit
                </a>
                <form action="/admin/specialties/<%= s.id %>/delete" method="POST" onsubmit="return confirm('Remove this clinical specialty card?')" class="d-inline">
                  <button class="btn btn-sm btn-outline-danger rounded-circle p-2" style="width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;" title="Delete Specialty">
                    <i class="ri-delete-bin-line"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- ============ ADD CLINICAL SPECIALTY MODAL POP-UP ============ -->
<div class="modal fade" id="addSpecialtyModal" tabindex="-1" aria-labelledby="addSpecialtyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
      <div class="modal-header bg-primary text-white p-4">
        <h5 class="modal-title font-weight-bold text-white d-flex align-items-center gap-2" id="addSpecialtyModalLabel">
          <i class="ri-add-circle-fill text-warning fs-4"></i> Add New Clinical Specialty Card
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/admin/specialties" method="POST">
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label font-weight-bold">Specialty Name</label>
              <input type="text" name="name" class="form-control form-control-lg" placeholder="e.g. Cardiopulmonary Rehab" required>
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold">Badge Label</label>
              <input type="text" name="badge" class="form-control form-control-lg" placeholder="e.g. Heart & Lung, Senior Care" value="Clinical Rehab" required>
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold">Remix Icon Class</label>
              <input type="text" name="icon" class="form-control" value="ri-heart-pulse-fill" placeholder="e.g. ri-hospital-fill, ri-user-heart-fill">
              <span class="text-muted small">Supports Remix Icons (e.g. <code>ri-hospital-fill</code>, <code>ri-body-scan-fill</code>)</span>
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold">Theme Accent Color</label>
              <select name="theme" class="form-select">
                <option value="primary" selected>Primary (Royal Blue)</option>
                <option value="success">Success (Emerald Green)</option>
                <option value="warning">Warning (Amber Gold)</option>
                <option value="danger">Danger (Coral Red)</option>
                <option value="info">Info (Cyan Sky)</option>
                <option value="purple">Purple (Amethyst)</option>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold text-primary">
                <i class="ri-sort-asc me-1"></i> Position / Display Order
              </label>
              <input type="number" name="display_order" class="form-control form-control-lg fw-bold text-primary border-primary" value="<%= specialties.length + 1 %>" min="1" required>
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold">Initial Status</label>
              <select name="is_active" class="form-select form-select-lg">
                <option value="1" selected>Enabled (Visible on Homepage)</option>
                <option value="0">Disabled (Hidden)</option>
              </select>
            </div>

            <div class="col-12">
              <label class="form-label font-weight-bold">Clinical Items (1 item per line or comma separated)</label>
              <textarea name="items" rows="4" class="form-control" placeholder="Post-Heart Surgery Recovery&#10;COPD & Asthma Management&#10;Chest Physiotherapy" required></textarea>
            </div>
          </div>
        </div>

        <div class="modal-footer bg-light p-3 border-top justify-content-between">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 font-weight-bold shadow-sm py-2">
            <i class="ri-check-line me-1"></i> Add Specialty Card
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
