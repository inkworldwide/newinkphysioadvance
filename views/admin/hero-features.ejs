<!-- Top Action Header -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
  <div>
    <h4 class="mb-1 fw-bold text-dark"><i class="ri-apps-2-line me-2 text-primary"></i>Homepage Hero Feature Cards</h4>
    <p class="text-muted small mb-0">Manage pillar feature cards displayed directly below the homepage hero banner.</p>
  </div>
  <button type="button" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm font-weight-bold" data-bs-toggle="modal" data-bs-target="#addHeroFeatureModal">
    <i class="ri-add-circle-line me-1"></i> Add Hero Card
  </button>
</div>

<!-- Full-Width Hero Feature Cards Table -->
<div class="card shadow-sm border-0" style="border-radius: 16px;">
  <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
    <h5 class="mb-0 fw-bold text-dark"><i class="ri-list-check me-2 text-primary"></i>Feature Cards List</h5>
    <span class="badge bg-primary text-white rounded-pill px-3 py-2"><%= features.length %> Total Cards</span>
  </div>
  <div class="table-responsive">
    <table class="table pe-table align-middle mb-0">
      <thead class="bg-light">
        <tr>
          <th>Card Details</th>
          <th class="text-center">Display Order</th>
          <th>Theme Badge Color</th>
          <th>Target Link URL</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (features.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted-pe py-4">No feature cards added yet. Click "Add Hero Card" above to create one.</td></tr>
        <% } %>
        <% features.forEach(f => { %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-3">
                <div class="pe-feature-icon bg-<%= f.badge_color || 'primary' %>-subtle text-<%= f.badge_color || 'primary' %> p-2 rounded-3 fs-4" style="width:46px;height:46px;">
                  <i class="<%= f.icon || 'ri-star-line' %>"></i>
                </div>
                <div>
                  <div class="fw-bold text-dark fs-6"><%= f.title %></div>
                  <div class="text-muted small"><%= f.subtitle %></div>
                </div>
              </div>
            </td>
            <td class="text-center">
              <span class="badge bg-light text-primary border px-3 py-1 font-weight-bold">Pos #<%= f.display_order %></span>
            </td>
            <td>
              <span class="badge bg-<%= f.badge_color || 'primary' %> text-capitalize px-3 py-1">
                <%= f.badge_color || 'primary' %>
              </span>
            </td>
            <td>
              <code class="small text-primary"><%= f.url %></code>
            </td>
            <td class="text-end">
              <div class="d-flex align-items-center justify-content-end gap-2">
                <a href="/admin/features/<%= f.id %>/edit" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Edit Feature Card">
                  <i class="ri-edit-line me-1"></i> Edit
                </a>
                <form action="/admin/features/<%= f.id %>/delete" method="POST" onsubmit="return confirm('Remove this hero feature card?')" class="d-inline">
                  <button class="btn btn-sm btn-outline-danger rounded-circle p-2" style="width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;" title="Delete Card">
                    <i class="ri-delete-bin-line"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- ============ ADD HERO FEATURE CARD MODAL POP-UP ============ -->
<div class="modal fade" id="addHeroFeatureModal" tabindex="-1" aria-labelledby="addHeroFeatureModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; max-height: 90vh;">
      <div class="modal-header bg-primary text-white p-4">
        <h5 class="modal-title font-weight-bold text-white d-flex align-items-center gap-2" id="addHeroFeatureModalLabel">
          <i class="ri-add-circle-fill text-warning fs-4"></i> Add Hero Feature Card
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/admin/features" method="POST" class="d-flex flex-column h-100">
        <div class="modal-body p-4" style="overflow-y: auto;">
          <div class="mb-3">
            <label class="form-label font-weight-bold">Card Title</label>
            <input type="text" name="title" class="form-control form-control-lg" placeholder="e.g. Masterclasses, Live Q&A" required>
          </div>

          <div class="mb-3">
            <label class="form-label font-weight-bold">Subtitle / Number Count</label>
            <input type="text" name="subtitle" class="form-control" placeholder="e.g. 40+ Interactive Sessions" required>
          </div>

          <div class="mb-3">
            <label class="form-label font-weight-bold">Remix Icon Class</label>
            <input type="text" name="icon" class="form-control" value="ri-slideshow-3-line" placeholder="e.g. ri-slideshow-3-line, ri-video-download-line">
            <span class="text-muted small">Supports Remix Icons (e.g. <code>ri-live-line</code>, <code>ri-gift-line</code>)</span>
          </div>

          <div class="mb-3">
            <label class="form-label font-weight-bold">Target URL Link</label>
            <input type="text" name="url" class="form-control" value="/live-sessions" placeholder="e.g. /courses, /live-sessions, /subjects">
          </div>

          <div class="mb-3">
            <label class="form-label font-weight-bold">Theme Badge Color</label>
            <select name="badge_color" class="form-select">
              <option value="warning" selected>Warning (Amber Gold)</option>
              <option value="info">Info (Sky Blue)</option>
              <option value="success">Success (Emerald Green)</option>
              <option value="danger">Danger (Rose Red)</option>
              <option value="primary">Primary (Royal Blue)</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label font-weight-bold text-primary">
              <i class="ri-sort-asc me-1"></i> Position / Display Order
            </label>
            <input type="number" name="display_order" class="form-control fw-bold text-primary" value="<%= features.length + 1 %>" min="1" required>
          </div>
        </div>

        <div class="modal-footer bg-light p-3 border-top justify-content-between">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 font-weight-bold shadow-sm py-2">
            <i class="ri-check-line me-1"></i> Add Feature Card
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
