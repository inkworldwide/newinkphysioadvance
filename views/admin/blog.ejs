<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
  <div>
    <h3 class="fw-bold text-dark mb-1"><i class="ri-article-line text-primary me-2"></i>Blog & Articles</h3>
    <p class="text-muted small mb-0">Publish clinical articles, study guides, poems, and student experiences.</p>
  </div>
  <button type="button" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addBlogPostModal">
    <i class="ri-add-circle-fill me-1"></i> New Blog Post
  </button>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
  <div class="table-responsive">
    <table class="table pe-table align-middle mb-0">
      <thead>
        <tr>
          <th>Title</th>
          <th>Type</th>
          <th>Status</th>
          <th>Author</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (posts.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No blog posts published yet.</td></tr>
        <% } %>
        <% posts.forEach(p => { %>
          <tr>
            <td class="fw-bold text-dark fs-6"><%= p.title %></td>
            <td><span class="badge bg-info-subtle text-info font-weight-bold px-3 py-1 rounded-pill text-capitalize"><%= p.post_type %></span></td>
            <td>
              <span class="badge <%= p.status === 'published' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %> font-weight-bold px-3 py-1 rounded-pill text-capitalize">
                <%= p.status %>
              </span>
            </td>
            <td><span class="text-muted small"><%= p.author_name || 'System Admin' %></span></td>
            <td class="text-end">
              <div class="d-flex align-items-center justify-content-end gap-2">
                <a href="/blog/<%= p.slug %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="View Post">
                  <i class="ri-external-link-line me-1"></i> View
                </a>
                <form action="/admin/blog/<%= p.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this post?')">
                  <button class="btn btn-sm btn-outline-danger rounded-circle p-2" style="width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;" title="Delete Post">
                    <i class="ri-delete-bin-line"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- ============ ADD BLOG POST MODAL POP-UP ============ -->
<div class="modal fade" id="addBlogPostModal" tabindex="-1" aria-labelledby="addBlogPostModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; max-height: 90vh;">
      <div class="modal-header bg-primary text-white p-4">
        <h5 class="modal-title font-weight-bold text-white d-flex align-items-center gap-2" id="addBlogPostModalLabel">
          <i class="ri-add-circle-fill text-warning fs-4"></i> Create New Blog Post
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/admin/blog" method="POST" class="d-flex flex-column h-100">
        <div class="modal-body p-4" style="overflow-y: auto;">
          <div class="mb-3">
            <label class="form-label font-weight-bold">Post Title</label>
            <input type="text" name="title" class="form-control form-control-lg" placeholder="e.g. Understanding Lower Back Biomechanics" required>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label font-weight-bold">Post Type</label>
              <select name="post_type" class="form-select form-select-lg">
                <option value="article" selected>Article</option>
                <option value="poem">Poem</option>
                <option value="quote">Quote</option>
                <option value="experience">Experience</option>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold">Publish Status</label>
              <select name="status" class="form-select form-select-lg">
                <option value="published" selected>Published</option>
                <option value="draft">Draft (Hidden)</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label font-weight-bold">Short Excerpt</label>
            <textarea name="excerpt" rows="2" class="form-control" placeholder="Brief summary for preview cards..."></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label font-weight-bold">Full Post Content (HTML allowed)</label>
            <textarea name="content" rows="6" class="form-control" placeholder="Write full article content..."></textarea>
          </div>
        </div>

        <div class="modal-footer bg-light p-3 border-top justify-content-between">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 font-weight-bold shadow-sm py-2">
            <i class="ri-check-line me-1"></i> Save Post
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
