<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | PhysioEdvance</title>
  <meta name="description" content="PhysioEdvance — One-stop solution for physiotherapy students. Year-wise subjects, digital library, live classes, research desk, and blog.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/public.css">
  <link rel="icon" href="/images/logo-icon.png">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">

  <%- include('../partials/public-navbar') %>

  <% if (typeof successMessages !== 'undefined' && successMessages.length) { %>
    <div class="container mt-3">
      <% successMessages.forEach(msg => { %>
        <div class="alert alert-success d-flex align-items-center alert-dismissible fade show" role="alert">
          <i class="ri-checkbox-circle-fill me-2"></i> <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }) %>
    </div>
  <% } %>
  <% if (typeof errorMessages !== 'undefined' && errorMessages.length) { %>
    <div class="container mt-3">
      <% errorMessages.forEach(msg => { %>
        <div class="alert alert-danger d-flex align-items-center alert-dismissible fade show" role="alert">
          <i class="ri-error-warning-fill me-2"></i> <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }) %>
    </div>
  <% } %>

  <main>
    <%- body %>
  </main>

  <%- include('../partials/public-footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/protect.js"></script>
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    // === Subjects nested submenu (click on mobile, hover on desktop) ===
    document.querySelectorAll('.pe-submenu-trigger').forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        if (window.innerWidth < 992) {
          e.preventDefault();
          e.stopPropagation();
          var parent = this.closest('.dropdown-submenu');
          // close siblings
          document.querySelectorAll('.dropdown-submenu.open').forEach(function(el) {
            if (el !== parent) el.classList.remove('open');
          });
          parent.classList.toggle('open');
        }
      });
    });
    // Close submenus when main dropdown closes
    document.querySelectorAll('.pe-subjects-dropdown').forEach(function(dd) {
      dd.addEventListener('hidden.bs.dropdown', function() {
        document.querySelectorAll('.dropdown-submenu.open').forEach(function(el) {
          el.classList.remove('open');
        });
      });
    });

    // Featured Courses Swiper
    if (document.querySelector('.pe-courses-swiper')) {
      window.peCoursesSwiper = new Swiper('.pe-courses-swiper', {
        slidesPerView:1, slidesPerGroup:1, spaceBetween:20, loop:false,
        autoplay:{delay:3500,disableOnInteraction:false},
        pagination:{
          el:'.pe-courses-swiper .pe-swiper-pagination',
          clickable:true,
          renderBullet: function (index, className) {
            return '<span class="' + className + '">' + (index + 1) + '</span>';
          }
        },
        navigation:{prevEl:'.pe-courses-swiper .pe-swiper-prev',nextEl:'.pe-courses-swiper .pe-swiper-next'},
        breakpoints:{
          640:{slidesPerView:2, slidesPerGroup:2},
          1024:{slidesPerView:3, slidesPerGroup:3}
        }
      });
    }
    // Team Swiper
    if (document.querySelector('.pe-team-swiper')) {
      new Swiper('.pe-team-swiper', {
        slidesPerView:1, spaceBetween:24, loop:false,
        autoplay:{delay:3500,disableOnInteraction:false},
        pagination:{el:'.pe-team-swiper .pe-swiper-pagination',clickable:true},
        navigation:{prevEl:'.pe-team-swiper .pe-swiper-prev',nextEl:'.pe-team-swiper .pe-swiper-next'},
        breakpoints:{480:{slidesPerView:2},768:{slidesPerView:3},1024:{slidesPerView:4}}
      });
    }
    // Nested dropdown submenus — hover on desktop, click on mobile
    document.querySelectorAll('.dropdown-submenu .pe-submenu-trigger').forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        if (window.innerWidth < 992) {
          e.preventDefault();
          e.stopPropagation();
          var parent = this.closest('.dropdown-submenu');
          var isOpen = parent.classList.contains('open');
          // Close all siblings
          document.querySelectorAll('.dropdown-submenu.open').forEach(function(el) { el.classList.remove('open'); });
          if (!isOpen) parent.classList.add('open');
          // Show/hide submenu
          var sub = parent.querySelector('.pe-submenu');
          if (sub) sub.style.display = parent.classList.contains('open') ? 'block' : 'none';
        }
      });
    });
    // Close submenus when main dropdown closes
    document.getElementById('subjectsDropdown') && document.getElementById('subjectsDropdown').addEventListener('hidden.bs.dropdown', function() {
      document.querySelectorAll('.dropdown-submenu.open').forEach(function(el) {
        el.classList.remove('open');
        var sub = el.querySelector('.pe-submenu');
        if (sub) sub.style.display = '';
      });
    });
    // Scroll-reveal
    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.style.animationDelay = (entry.target.dataset.delay||'0')+'ms';
            entry.target.classList.add('pe-animate-up');
            obs.unobserve(entry.target);
          }
        });
      },{threshold:0.1});
      document.querySelectorAll('.pe-fc-card,.pe-subj-card,.pe-team-slide-card,.pe-service-card,.card:not(.pe-promo-card)').forEach(function(el,i){
        el.dataset.delay = (i%4)*80;
        obs.observe(el);
      });
    }
  });
  </script>
</body>
</html>
