<div class="pe-auth-wrapper">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-6">
        <div class="pe-auth-card">

          <div class="text-center mb-4">
            <img src="/images/logo-icon.png" alt="PhysioEdvance" class="mx-auto d-block" style="height:4rem;width:auto;">
            <h3 class="mt-3 mb-1">Login to PhysioEdvance</h3>
            <p class="text-muted-pe small">Two-step verification required to access your account</p>
          </div>

          <!-- Step indicator -->
          <div class="pe-step-bar mb-4">
            <div class="pe-step active">
              <div class="pe-step-num">1</div>
              <span>Email & Password</span>
            </div>
            <div class="pe-step-line"></div>
            <div class="pe-step">
              <div class="pe-step-num">2</div>
              <span>Face Verification</span>
            </div>
          </div>

          <!-- Step 1 notice -->
          <div class="pe-2fa-notice mb-4">
            <i class="ri-shield-keyhole-line"></i>
            <div>
              <strong>Step 1 of 2 — Password Login</strong>
              <p class="mb-0 small">After verifying your password, you will be asked to scan your face to complete login.</p>
            </div>
          </div>

          <!-- Flash messages -->
          <% if (typeof messages !== 'undefined') { %>
            <% (messages.error || []).forEach(m => { %>
              <div class="alert alert-danger alert-dismissible d-flex align-items-center gap-2" role="alert">
                <i class="ri-error-warning-line flex-shrink-0"></i><div><%= m %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
              </div>
            <% }) %>
          <% } %>

          <!-- Password login form -->
          <form action="/auth/login" method="POST">
            <input type="hidden" name="redirect" value="<%= redirectTo %>">
            <div class="mb-3">
              <label class="form-label">Email Address</label>
              <div class="position-relative">
                <span class="pe-input-icon"><i class="ri-mail-line"></i></span>
                <input type="email" name="email" class="form-control pe-input-padded"
                  placeholder="you@example.com" required autofocus>
              </div>
            </div>
            <div class="mb-4">
              <label class="form-label">Password</label>
              <div class="position-relative">
                <span class="pe-input-icon"><i class="ri-lock-line"></i></span>
                <input type="password" name="password" id="pwdField"
                  class="form-control pe-input-padded" placeholder="••••••••" required>
                <button type="button" class="pe-pwd-toggle" onclick="togglePwd('pwdField',this)">
                  <i class="ri-eye-off-line"></i>
                </button>
              </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg mb-3">
              <i class="ri-arrow-right-circle-line me-1"></i> Continue to Face Verification →
            </button>
          </form>

          <div class="pe-2fa-info text-center">
            <i class="ri-face-recognition-line me-1 text-primary-pe"></i>
            Face scan will be required in Step 2 — have your camera ready
          </div>

          <p class="text-center small text-muted-pe mb-0 mt-3">
            Don't have an account? <a href="/auth/register" class="fw-600">Sign up free</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function togglePwd(id, btn) {
  var f = document.getElementById(id);
  f.type = f.type === 'password' ? 'text' : 'password';
  btn.querySelector('i').className = f.type === 'password' ? 'ri-eye-off-line' : 'ri-eye-line';
}
</script>
