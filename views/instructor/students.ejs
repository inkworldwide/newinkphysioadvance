<div class="d-flex justify-content-between align-items-center mb-4">
  <h5 class="mb-0">Students Enrolled in "<%= course.title %>"</h5>
  <a href="/instructor/courses" class="btn btn-outline-primary btn-sm">Back to Courses</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table pe-table mb-0">
      <thead><tr><th>Student</th><th>Email</th><th>Progress</th><th>Status</th><th>Enrolled On</th></tr></thead>
      <tbody>
        <% if (students.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted-pe py-4">No students enrolled yet.</td></tr>
        <% } %>
        <% students.forEach(s => { %>
          <tr>
            <td class="d-flex align-items-center gap-2">
              <img src="<%= s.avatar %>" class="rounded-circle avatar-xs" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(s.name) %>&background=0a5dc2&color=fff'">
              <%= s.name %>
            </td>
            <td><%= s.email %></td>
            <td style="width:160px;">
              <div class="progress"><div class="progress-bar" style="width:<%= s.progress_percent %>%"></div></div>
              <span class="small text-muted-pe"><%= Math.round(s.progress_percent) %>%</span>
            </td>
            <td><span class="badge <%= s.status === 'completed' ? 'badge-soft-success' : 'badge-soft-primary' %> text-capitalize"><%= s.status %></span></td>
            <td class="text-muted-pe"><%= new Date(s.enrolled_at).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
