<!-- ============ CLEAN & EXECUTIVE INSTRUCTOR DASHBOARD ============ -->

<!-- 1. SLEEK EXECUTIVE HERO BANNER -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 position-relative" style="background: linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%);">
  <div class="card-body p-4 p-md-4.5 text-white">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
      
      <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.2);">
          <span class="bg-warning rounded-circle" style="width: 7px; height: 7px;"></span>
          <span class="text-white small font-weight-bold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Faculty Portal & Academic Dashboard</span>
        </div>
        <h2 class="fw-bold text-white mb-1" style="letter-spacing: -0.02em;">Welcome back, <%= currentUser.name %></h2>
        <p class="text-white-75 mb-0 small" style="max-width: 580px;">Manage your physiotherapy courses, interactive 3D models, internal videos, notes, and student progress in real-time.</p>
      </div>

      <div>
        <a href="/instructor/courses/wizard" class="btn btn-warning rounded-pill px-4 py-2.5 font-weight-bold text-dark shadow-sm d-inline-flex align-items-center gap-2" style="background-color: #f59e0b !important; border: none;">
          <i class="ri-add-circle-fill fs-5"></i> + Create New Course
        </a>
      </div>

    </div>
  </div>
</div>

<!-- 2. ELEGANT KPI STAT CARDS -->
<div class="row g-3 mb-4">
  
  <div class="col-xl-3 col-md-6 col-6">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 transition-all hover-shadow">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <span class="text-secondary small font-weight-bold text-uppercase" style="letter-spacing: 0.04em;">My Courses</span>
        <div class="rounded-4 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(10, 93, 194, 0.1); color: #0a5dc2;">
          <i class="ri-book-2-line fs-4"></i>
        </div>
      </div>
      <h2 class="fw-bold text-dark mb-0" style="font-size: 1.85rem;"><%= courses.length %></h2>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 col-6">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 transition-all hover-shadow">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <span class="text-secondary small font-weight-bold text-uppercase" style="letter-spacing: 0.04em;">Total Students</span>
        <div class="rounded-4 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(16, 185, 129, 0.1); color: #10b981;">
          <i class="ri-group-line fs-4"></i>
        </div>
      </div>
      <h2 class="fw-bold text-dark mb-0" style="font-size: 1.85rem;"><%= totalStudents.toLocaleString() %></h2>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 col-6">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 transition-all hover-shadow">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <span class="text-secondary small font-weight-bold text-uppercase" style="letter-spacing: 0.04em;">Total Revenue</span>
        <div class="rounded-4 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
          <i class="ri-money-rupee-circle-line fs-4"></i>
        </div>
      </div>
      <h2 class="fw-bold text-dark mb-0" style="font-size: 1.85rem;">₹<%= totalRevenue.toLocaleString() %></h2>
    </div>
  </div>

  <div class="col-xl-3 col-md-6 col-6">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 transition-all hover-shadow">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <span class="text-secondary small font-weight-bold text-uppercase" style="letter-spacing: 0.04em;">Avg. Rating</span>
        <div class="rounded-4 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(2, 132, 199, 0.1); color: #0284c7;">
          <i class="ri-star-fill fs-4 text-warning"></i>
        </div>
      </div>
      <h2 class="fw-bold text-dark mb-0" style="font-size: 1.85rem;"><%= avgRating %> <span class="fs-6 text-warning">★</span></h2>
    </div>
  </div>

</div>

<!-- 3. FULL WIDTH COURSES TABLE -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden border bg-white mb-4">
  <div class="card-header bg-white p-3.5 border-bottom">
    <h6 class="fw-bold text-dark mb-0"><i class="ri-book-open-line text-primary me-2"></i>My Active Teaching Courses</h6>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light">
        <tr>
          <th class="ps-4">Course</th>
          <th>Subject Category</th>
          <th>Status</th>
          <th>Enrolled Students</th>
          <th>Rating</th>
          <th class="text-end pe-4">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (courses.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center text-muted py-4">
              <p class="mb-2">You haven't created any courses yet.</p>
              <a href="/instructor/courses/wizard" class="btn btn-sm btn-primary rounded-pill px-3">Create Course Wizard</a>
            </td>
          </tr>
        <% } %>
        <% courses.forEach(c => { %>
          <tr>
            <td class="ps-4">
              <div class="d-flex align-items-center gap-3">
                <img src="<%= c.thumbnail || '/images/courses/course-placeholder.jpg' %>" class="rounded-3 shadow-sm" style="width: 48px; height: 36px; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(c.title) %>&background=0a5dc2&color=fff'">
                <div>
                  <h6 class="fw-bold text-dark mb-0 line-clamp-1"><%= c.title %></h6>
                  <span class="text-muted small"><%= c.subtitle || c.target_exam || 'Physiotherapy Subject' %></span>
                </div>
              </div>
            </td>
            <td>
              <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill small font-weight-semibold">
                <%= c.target_exam || 'BPT Year 1' %>
              </span>
            </td>
            <td>
              <span class="badge <%= c.status === 'published' ? 'bg-success text-white' : 'bg-warning text-dark' %> font-weight-bold px-2.5 py-1 rounded-pill">
                <%= c.status === 'published' ? 'Published' : 'Draft' %>
              </span>
            </td>
            <td class="fw-bold text-dark"><i class="ri-group-line text-primary me-1"></i> <%= c.students_count || 0 %></td>
            <td><span class="text-warning font-weight-bold"><i class="ri-star-fill me-1"></i> <%= (c.rating_avg || 5.0).toFixed(1) %></span></td>
            <td class="text-end pe-4">
              <a href="/instructor/courses/wizard?courseId=<%= c.id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3 font-weight-bold">
                <i class="ri-edit-line me-1"></i> Edit Course
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
