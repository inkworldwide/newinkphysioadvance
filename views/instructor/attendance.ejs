<div class="d-flex justify-content-between align-items-center mb-4">
  <h5 class="mb-0">Attendance — "<%= course.title %>"</h5>
  <a href="/instructor/courses/<%= course.id %>/edit" class="btn btn-outline-primary btn-sm">Back to Course</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table pe-table mb-0">
      <thead><tr><th>Student</th><th>Email</th><th>Method</th><th>Match Confidence</th><th>Date & Time</th></tr></thead>
      <tbody>
        <% if (records.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted-pe py-4">No attendance records yet for this course.</td></tr>
        <% } %>
        <% records.forEach(r => { %>
          <tr>
            <td class="fw-semibold"><%= r.student_name %></td>
            <td><%= r.student_email %></td>
            <td><span class="badge badge-soft-info text-capitalize"><%= r.method %></span></td>
            <td><%= r.match_distance !== null ? (100 - r.match_distance * 100).toFixed(1) + '%' : '—' %></td>
            <td class="text-muted-pe"><%= new Date(r.marked_at).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
