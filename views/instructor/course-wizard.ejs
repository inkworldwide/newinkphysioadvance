<!-- INTERACTIVE JS CLICK HANDLERS -->
<script>
  function togglePortalPanel(id) {
    const card = document.getElementById('card-' + id);
    const badge = document.getElementById('badge-' + id);
    const panel = document.getElementById('portal-panel-' + id);

    if (panel) {
      if (panel.classList.contains('d-none')) {
        panel.classList.remove('d-none');
        if (card) {
          card.classList.add('border-primary', 'shadow');
          card.style.borderWidth = '2px';
        }
        if (badge) {
          badge.classList.remove('d-none', 'bg-secondary');
          badge.classList.add('bg-primary');
        }
      } else {
        panel.classList.add('d-none');
        if (card) {
          card.classList.remove('border-primary', 'shadow');
          card.style.borderWidth = '1px';
        }
        if (badge) {
          badge.classList.add('d-none');
        }
      }
    }
  }

  function addRegionRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-5"><input type="text" name="region_name[]" class="form-control rounded-3" placeholder="Region Name"></div>
      <div class="col-md-7"><input type="text" name="region_desc[]" class="form-control rounded-3" placeholder="Description & Nerve Pathways"></div>
    </div>`;
    document.getElementById('regionsContainer').insertAdjacentHTML('beforeend', html);
  }

  function addCrossSectionRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-4"><input type="text" name="cross_title[]" class="form-control rounded-3" placeholder="Section Title"></div>
      <div class="col-md-4"><input type="text" name="cross_image[]" class="form-control rounded-3" placeholder="Image URL / File"></div>
      <div class="col-md-4"><input type="text" name="cross_desc[]" class="form-control rounded-3" placeholder="Tissue Layer Description"></div>
    </div>`;
    document.getElementById('crossSectionsContainer').insertAdjacentHTML('beforeend', html);
  }

  function addHDVideoRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-6"><input type="text" name="hd_video_title[]" class="form-control rounded-3" placeholder="Lecture Title"></div>
      <div class="col-md-6"><input type="text" name="hd_video_url[]" class="form-control rounded-3" placeholder="Embed Stream URL"></div>
    </div>`;
    document.getElementById('hdVideosContainer').insertAdjacentHTML('beforeend', html);
  }

  function addHotspotRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-4"><input type="text" name="pin_title[]" class="form-control rounded-3" placeholder="Pin Title"></div>
      <div class="col-md-4"><input type="text" name="pin_origin[]" class="form-control rounded-3" placeholder="Origin & Insertion"></div>
      <div class="col-md-4"><input type="text" name="pin_nerve[]" class="form-control rounded-3" placeholder="Nerve Supply & Action"></div>
    </div>`;
    document.getElementById('hotspotsContainer').insertAdjacentHTML('beforeend', html);
  }

  function addRadiologyRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-5"><input type="text" name="mri_title[]" class="form-control rounded-3" placeholder="Case Title"></div>
      <div class="col-md-3"><select name="mri_type[]" class="form-select rounded-3"><option value="MRI T2">MRI T2</option><option value="X-Ray">X-Ray</option><option value="CT Scan">CT Scan</option></select></div>
      <div class="col-md-4"><input type="text" name="mri_image[]" class="form-control rounded-3" placeholder="Image URL / File"></div>
    </div>`;
    document.getElementById('radiologyContainer').insertAdjacentHTML('beforeend', html);
