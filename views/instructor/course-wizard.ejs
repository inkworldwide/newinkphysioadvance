  function addSyllabusRow() {
    const html = `<div class="row g-3 mb-2 p-3 bg-white rounded-3 border">
      <div class="col-md-4"><input type="text" name="unit_title[]" class="form-control rounded-3" placeholder="Unit Header"></div>
