<!-- ============ INSTRUCTOR UNIFIED COURSE CREATOR DASHBOARD ============ -->
<div class="container-fluid py-4">
  
  <!-- Header Title & Quick Actions -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark mb-1">
        <i class="ri-magic-line text-primary me-2"></i><%= course ? 'Edit Course Dashboard' : 'Create New Course Studio' %>
      </h3>
      <p class="text-secondary small mb-0">Unified all-in-one studio to upload course videos, thumbnail images, build modules, and configure interactive portal features.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/instructor/courses" class="btn btn-outline-secondary rounded-pill px-3.5 font-weight-medium">
        <i class="ri-arrow-left-line me-1"></i> My Courses
      </a>
      <% if (course) { %>
        <a href="/subjects/<%= (categories.find(c => c.id === course.category_id) || {}).slug || course.slug %>" target="_blank" class="btn btn-outline-info rounded-pill px-3.5 font-weight-medium">
          <i class="ri-eye-line me-1"></i> Preview Interactive Portal
        </a>
      <% } %>
    </div>
  </div>

  <!-- ALL-IN-ONE COURSE CREATOR FORM WITH DUAL FILE UPLOADS -->
  <form action="/instructor/courses/wizard/save" method="POST" enctype="multipart/form-data" id="courseCreatorForm">
    <input type="hidden" name="course_id" value="<%= course ? course.id : '' %>">

    <!-- ============ SECTION 1: BASIC COURSE INFORMATION & THUMBNAIL ============ -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4">
      <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
        <h5 class="fw-bold text-dark mb-0">
          <span class="badge bg-primary rounded-circle me-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">1</span> Basic Course Information & Thumbnail
        </h5>
        <span class="badge bg-light text-primary border rounded-pill px-3 py-1 font-weight-semibold">Step 1 of 3</span>
      </div>
      
      <div class="row g-3">
        <div class="col-12">
          <label class="form-label font-weight-semibold text-dark">Course Title <span class="text-danger">*</span></label>
          <input type="text" name="title" class="form-control rounded-3" value="<%= course ? course.title : '' %>" placeholder="e.g. Clinical Functional Anatomy & Movement Assessment" required>
        </div>

        <!-- 1. ACADEMIC YEAR SELECTOR (FIRST) -->
        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark"><i class="ri-calendar-event-line text-primary me-1"></i> 1. Select Academic Year / Program <span class="text-danger">*</span></label>
          <select name="target_exam" id="yearSelector" class="form-select rounded-3 font-weight-bold border-primary text-primary" onchange="filterSubjectsByYear(this.value)" required>
            <option value="BPT 1st Year" <%= (course && course.target_exam === 'BPT 1st Year') ? 'selected' : '' %>>BPT 1st Year (First Year Foundation)</option>
            <option value="BPT 2nd Year" <%= (course && course.target_exam === 'BPT 2nd Year') ? 'selected' : '' %>>BPT 2nd Year (Second Year Core Clinical)</option>
            <option value="BPT 3rd Year" <%= (course && course.target_exam === 'BPT 3rd Year') ? 'selected' : '' %>>BPT 3rd Year (Third Year Advanced Clinical)</option>
            <option value="BPT 4th Year" <%= (course && course.target_exam === 'BPT 4th Year') ? 'selected' : '' %>>BPT 4th Year (Fourth Year Specialisation)</option>
            <option value="Other Electives" <%= (course && course.target_exam === 'Other Electives') ? 'selected' : '' %>>Other Subjects / Electives</option>
          </select>
        </div>

        <!-- 2. DEPENDENT SUBJECT CATEGORY DROPDOWN (FILTERED BY SELECTED YEAR) -->
        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark"><i class="ri-book-open-line text-success me-1"></i> 2. Select Subject (Filtered by Selected Year) <span class="text-danger">*</span></label>
          <select name="category_id" id="subjectCategorySelector" class="form-select rounded-3 font-weight-bold" required>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" data-year="<%= cat.year || 'other' %>" <%= (course && course.category_id === cat.id) ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-12">
          <label class="form-label font-weight-semibold text-dark">Subtitle (One-Line Summary)</label>
          <input type="text" name="subtitle" class="form-control rounded-3" value="<%= course ? course.subtitle : '' %>" placeholder="e.g. Master human osteology, muscle origins/insertions, and nerve pathways.">
        </div>

        <div class="col-12">
          <label class="form-label font-weight-semibold text-dark">Full Course Description</label>
          <textarea name="description" rows="3" class="form-control rounded-3" placeholder="Explain what students will master in this physiotherapy course..."><%= course ? course.description : '' %></textarea>
        </div>

        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark">Difficulty Level</label>
          <select name="level" class="form-select rounded-3">
            <option value="Beginner" <%= (course && course.level === 'Beginner') ? 'selected' : '' %>>Beginner</option>
            <option value="Intermediate" <%= (course && course.level === 'Intermediate') ? 'selected' : '' %>>Intermediate</option>
            <option value="Advanced" <%= (course && course.level === 'Advanced') ? 'selected' : '' %>>Advanced</option>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark">Estimated Duration (Hours)</label>
          <input type="number" name="duration_hours" class="form-control rounded-3" value="<%= course ? course.duration_hours : 12 %>">
        </div>

        <!-- THUMBNAIL UPLOAD -->
        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark">
            <i class="ri-image-add-line text-primary me-1"></i> Upload Course Thumbnail Image (File)
          </label>
          <input type="file" name="thumbnail_file" class="form-control rounded-3" accept="image/*">
          <span class="text-muted small d-block mt-1">Upload JPG, PNG, or WebP image from your computer.</span>
        </div>

        <div class="col-md-6">
          <label class="form-label font-weight-semibold text-dark">
            <i class="ri-link text-secondary me-1"></i> Or Enter Thumbnail Image URL
          </label>
          <input type="text" name="thumbnail" class="form-control rounded-3" value="<%= course ? course.thumbnail : '/images/courses/course-placeholder.jpg' %>" placeholder="/images/courses/course-placeholder.jpg">
          <span class="text-muted small d-block mt-1">URL fallback path if no file is uploaded.</span>
        </div>

      </div>
    </div>

    <!-- ============ SECTION 2: MODULE BUILDER & MP4 VIDEO UPLOAD ============ -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4">
      <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
        <h5 class="fw-bold text-dark mb-0">
          <span class="badge bg-primary rounded-circle me-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">2</span> Module & MP4 Lesson Video Upload
        </h5>
        <span class="badge bg-light text-primary border rounded-pill px-3 py-1 font-weight-semibold">Step 2 of 3</span>
      </div>

      <div class="p-4 bg-light rounded-4 border mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
          <h6 class="fw-bold text-dark mb-0"><i class="ri-folder-add-fill text-primary me-1"></i>Target Module & Video Lessons Builder</h6>
          <button type="button" class="btn btn-sm btn-outline-primary rounded-pill font-weight-bold" onclick="addLessonRow()">
            <i class="ri-video-add-line me-1"></i> + Add Another Video Lesson
          </button>
        </div>

        <% if (modules && modules.length > 0) { %>
          <div class="mb-3 p-3 bg-white rounded-3 border">
            <label class="form-label small font-weight-semibold text-primary">Select Target Module to Add Video Lessons To:</label>
            <select name="existing_module_id" class="form-select rounded-3 font-weight-bold">
              <option value="">-- Create a New Module Below --</option>
              <% modules.forEach((m, idx) => { %>
                <option value="<%= m.id %>">Module <%= idx + 1 %>: <%= m.title %></option>
              <% }) %>
            </select>
          </div>
        <% } %>
        
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label small font-weight-semibold">New Module Title (If Creating New Module)</label>
            <input type="text" name="module_title" class="form-control rounded-3" placeholder="e.g. Module 1: Functional Osteology & Joint Mechanics">
          </div>
          <div class="col-md-6">
            <label class="form-label small font-weight-semibold">Module Description & Objectives</label>
            <input type="text" name="module_description" class="form-control rounded-3" placeholder="Explain what students will master in this module...">
          </div>
        </div>

        <!-- CONTAINER FOR DYNAMIC VIDEO LESSON ROWS -->
        <div id="lessonsContainer">
          <div class="p-3 bg-white rounded-3 border mb-3 lesson-row-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="badge bg-primary rounded-pill px-3 py-1 font-weight-bold">Video Lesson 1</span>
            </div>

            <div class="row g-3">
              <div class="col-md-8">
                <label class="form-label small font-weight-semibold">Lesson Title <span class="text-danger">*</span></label>
                <input type="text" name="lesson_title" class="form-control rounded-3" placeholder="e.g. Lesson 1: Upper Limb Bone Landmarks & Muscle Attachments">
              </div>
              <div class="col-md-4">
                <label class="form-label small font-weight-semibold">Lesson Duration (Minutes)</label>
                <input type="number" name="duration_minutes" class="form-control rounded-3" value="18">
              </div>

              <!-- DIRECT VIDEO FILE UPLOAD -->
              <div class="col-md-6">
                <label class="form-label small font-weight-semibold text-primary">
                  <i class="ri-upload-cloud-2-line me-1"></i> Upload MP4 Lesson Video File
                </label>
                <input type="file" name="video_file" class="form-control rounded-3" accept="video/mp4,video/webm">
                <span class="text-muted small d-block mt-1">Upload MP4 or WebM video file directly from your computer.</span>
              </div>

              <div class="col-md-6">
                <label class="form-label small font-weight-semibold text-secondary">
                  <i class="ri-link me-1"></i> Or Enter Internal Video Stream URL
                </label>
                <input type="text" name="video_url" class="form-control rounded-3" value="/videos/stream/anat-m1-l1" placeholder="/videos/stream/anat-m1-l1">
                <span class="text-muted small d-block mt-1">Stream path fallback if no video file is selected.</span>
              </div>

              <!-- DIRECT PDF / NOTES FILE UPLOAD SECTION -->
              <div class="col-md-6">
                <label class="form-label small font-weight-semibold text-danger">
                  <i class="ri-file-pdf-2-line me-1"></i> Upload PDF Study Notes / Handout Document
                </label>
                <input type="file" name="pdf_file" class="form-control rounded-3" accept=".pdf,.doc,.docx,.ppt,.pptx">
                <span class="text-muted small d-block mt-1">Attach PDF study guide, lecture slides, or exam key points.</span>
              </div>

              <div class="col-md-6">
                <label class="form-label small font-weight-semibold text-secondary">
                  <i class="ri-drive-line me-1"></i> Or Enter PDF Link / Google Drive URL
                </label>
                <input type="text" name="pdf_url" class="form-control rounded-3" placeholder="https://drive.google.com/... or /uploads/notes/lecture1.pdf">
                <span class="text-muted small d-block mt-1">Direct PDF link or cloud document URL fallback.</span>
              </div>

              <div class="col-12">
                <label class="form-label small font-weight-semibold">In-Built Study Notes & Key Points</label>
                <textarea name="lesson_notes" rows="2" class="form-control rounded-3" placeholder="Type key clinical notes and exam takeaways for students..."></textarea>
              </div>
            </div>
          </div>
        </div>

      </div>

      <% if (modules && modules.length > 0) { %>
        <h6 class="fw-bold text-dark mb-2"><i class="ri-list-check me-1"></i>Current Course Modules & Uploaded Video Lessons:</h6>
        <div class="accordion mb-3" id="courseModulesAccordion">
          <% modules.forEach((m, idx) => { %>
            <div class="accordion-item border rounded-3 mb-2 overflow-hidden">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed font-weight-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#mod-<%= m.id %>">
                  <span class="badge bg-primary me-2">Module <%= idx + 1 %></span> <%= m.title %> (<%= m.lessons.length %> video lessons)
                </button>
              </h2>
              <div id="mod-<%= m.id %>" class="accordion-collapse collapse p-3 bg-light">
                <p class="text-muted small mb-2"><%= m.description || 'No module description provided.' %></p>
                <ul class="list-group list-group-flush rounded-3">
                  <% m.lessons.forEach(l => { %>
                    <li class="list-group-item d-flex align-items-center justify-content-between small">
                      <span><i class="ri-play-circle-fill me-2 text-primary"></i><%= l.title %></span>
                      <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border"><%= l.video_url || 'Internal Video' %></span>
                        <span class="badge bg-secondary"><%= l.duration_minutes %> mins</span>
                      </div>
                    </li>
                  <% }) %>
                </ul>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

    </div>

    <!-- ============ SECTION 3: SUBJECT INTERACTIVE PORTAL 9 FEATURE OPTIONS ============ -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4">
      <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
        <h5 class="fw-bold text-dark mb-0">
          <span class="badge bg-primary rounded-circle me-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">3</span> Subject Interactive Portal 9 Feature Options
        </h5>
        <span class="badge bg-light text-primary border rounded-pill px-3 py-1 font-weight-semibold">Step 3 of 3</span>
      </div>
      
      <p class="text-muted small mb-4">Click any option card below to toggle active state and open its dedicated feature configuration panel.</p>

      <!-- 9 CLICKABLE INTERACTIVE FEATURE CARDS -->
      <div class="row g-3 mb-4">
        
        <!-- 1. Center 3D Video Stream -->
        <div class="col-md-4 col-sm-6">
          <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white border-primary active-card" id="card-1" onclick="togglePortalPanel(1)" style="cursor: pointer;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-primary-subtle text-primary fw-bold"><i class="ri-film-line fs-4"></i></div>
                <h6 class="fw-bold text-dark mb-0">1. Center 3D Video Stream</h6>
              </div>
              <span class="badge bg-primary rounded-pill px-2 py-1 small" id="badge-1"><i class="ri-check-line"></i> Active</span>
            </div>
            <p class="text-secondary small mb-0">Internal MP4 video prosections & faculty demonstrations</p>
          </div>
        </div>

        <!-- 2. 3D WebGL Rotatable -->
        <div class="col-md-4 col-sm-6">
          <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white" id="card-2" onclick="togglePortalPanel(2)" style="cursor: pointer;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-warning-subtle text-warning fw-bold"><i class="ri-box-3-line fs-4"></i></div>
                <h6 class="fw-bold text-dark mb-0">2. 3D WebGL Rotatable</h6>
              </div>
              <span class="badge bg-secondary rounded-pill px-2 py-1 small d-none" id="badge-2"><i class="ri-check-line"></i> Active</span>
            </div>
            <p class="text-secondary small mb-0">360° rotatable anatomical joint & skeletal models</p>
          </div>
        </div>

        <!-- 3. Regions & Maps -->
        <div class="col-md-4 col-sm-6">
          <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white" id="card-3" onclick="togglePortalPanel(3)" style="cursor: pointer;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-info-subtle text-info fw-bold"><i class="ri-brain-line fs-4"></i></div>
                <h6 class="fw-bold text-dark mb-0">3. Regions & Maps</h6>
              </div>
              <span class="badge bg-secondary rounded-pill px-2 py-1 small d-none" id="badge-3"><i class="ri-check-line"></i> Active</span>
            </div>
            <p class="text-secondary small mb-0">Structural maps, nerve pathways & functional zones</p>
          </div>
        </div>

        <!-- 4. Cross-Sections -->
        <div class="col-md-4 col-sm-6">
          <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white" id="card-4" onclick="togglePortalPanel(4)" style="cursor: pointer;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-success-subtle text-success fw-bold"><i class="ri-layout-grid-line fs-4"></i></div>
                <h6 class="fw-bold text-dark mb-0">4. Cross-Sections</h6>
              </div>
              <span class="badge bg-secondary rounded-pill px-2 py-1 small d-none" id="badge-4"><i class="ri-check-line"></i> Active</span>
            </div>
            <p class="text-secondary small mb-0">Transverse & sagittal cross-sectional tissue slices</p>
          </div>
        </div>

        <!-- 5. HD Video Lectures -->
        <div class="col-md-4 col-sm-6">
          <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white" id="card-5" onclick="togglePortalPanel(5)" style="cursor: pointer;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-danger-subtle text-danger fw-bold"><i class="ri-vidicon-line fs-4"></i></div>
                <h6 class="fw-bold text-dark mb-0">5. HD Video Lectures</h6>
              </div>
              <span class="badge bg-secondary rounded-pill px-2 py-1 small d-none" id="badge-5"><i class="ri-check-line"></i> Active</span>
            </div>
            <p class="text-secondary small mb-0">Dissection guides & clinical skill walkthroughs</p>
          </div>
        </div>

        <!-- 6. Interactive Hotspots -->
        <div class="col-md-4 col-sm-6">
          <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white" id="card-6" onclick="togglePortalPanel(6)" style="cursor: pointer;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-primary-subtle text-primary fw-bold"><i class="ri-focus-3-line fs-4"></i></div>
                <h6 class="fw-bold text-dark mb-0">6. Interactive Hotspots</h6>
              </div>
              <span class="badge bg-secondary rounded-pill px-2 py-1 small d-none" id="badge-6"><i class="ri-check-line"></i> Active</span>
            </div>
            <p class="text-secondary small mb-0">Interactive diagram explorer with pin annotations</p>
          </div>
        </div>

        <!-- 7. MRIs & Radiology -->
        <div class="col-md-4 col-sm-6">
          <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white" id="card-7" onclick="togglePortalPanel(7)" style="cursor: pointer;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-info-subtle text-info fw-bold"><i class="ri-pulse-line fs-4"></i></div>
                <h6 class="fw-bold text-dark mb-0">7. MRIs & Radiology</h6>
              </div>
              <span class="badge bg-secondary rounded-pill px-2 py-1 small d-none" id="badge-7"><i class="ri-check-line"></i> Active</span>
            </div>
            <p class="text-secondary small mb-0">Diagnostic X-rays, MRI scans & clinical imaging</p>
          </div>
        </div>

        <!-- 8. Subject Syllabus -->
        <div class="col-md-4 col-sm-6">
          <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white" id="card-8" onclick="togglePortalPanel(8)" style="cursor: pointer;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-secondary-subtle text-secondary fw-bold"><i class="ri-quill-pen-line fs-4"></i></div>
                <h6 class="fw-bold text-dark mb-0">8. Subject Syllabus</h6>
              </div>
              <span class="badge bg-secondary rounded-pill px-2 py-1 small d-none" id="badge-8"><i class="ri-check-line"></i> Active</span>
            </div>
            <p class="text-secondary small mb-0">Unit-by-unit BPT academic syllabus & exam topics</p>
          </div>
        </div>

        <!-- 9. Stroke & Pathology -->
        <div class="col-md-4 col-sm-6">
          <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white" id="card-9" onclick="togglePortalPanel(9)" style="cursor: pointer;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-danger-subtle text-danger fw-bold"><i class="ri-heart-pulse-line fs-4"></i></div>
                <h6 class="fw-bold text-dark mb-0">9. Stroke & Pathology</h6>
              </div>
              <span class="badge bg-secondary rounded-pill px-2 py-1 small d-none" id="badge-9"><i class="ri-check-line"></i> Active</span>
            </div>
            <p class="text-secondary small mb-0">Pathology models & clinical rehabilitation protocols</p>
          </div>
        </div>

      </div>

      <!-- DEDICATED FEATURE CONFIGURATION PANELS 1 TO 9 -->
      <div class="card border-0 shadow-sm p-4 bg-light rounded-4 mb-4 border" id="portal-panel-1">
        <h6 class="fw-bold text-dark mb-3 border-bottom pb-2"><i class="ri-film-line text-primary me-2 fs-5"></i>1. Center 3D Video Stream Configuration</h6>
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label small font-weight-semibold">3D Video Stream Endpoint / MP4 URL</label>
            <input type="text" class="form-control rounded-3" value="/videos/stream/anat-m1-l1">
            <span class="form-text text-muted">Streams natively inside PhysioEdvance with zero YouTube dependencies.</span>
          </div>
          <div class="col-md-4">
            <label class="form-label small font-weight-semibold">Lesson Video Duration (Mins)</label>
            <input type="number" class="form-control rounded-3" value="18">
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm p-4 bg-light rounded-4 mb-4 border d-none" id="portal-panel-2">
        <h6 class="fw-bold text-dark mb-3 border-bottom pb-2"><i class="ri-box-3-line text-warning me-2 fs-5"></i>2. 3D WebGL Rotatable Model Configuration</h6>
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label small font-weight-semibold">3D WebGL Model File / Endpoint URL (.gltf / .glb)</label>
            <input type="text" name="webgl_model_url" class="form-control rounded-3" placeholder="/models/3d/shoulder-joint.glb">
          </div>
          <div class="col-md-4">
            <label class="form-label small font-weight-semibold">Rotatable Axis & Focus</label>
            <select name="webgl_focus" class="form-select rounded-3">
              <option value="360-full">360° Full Axis Rotation</option>
