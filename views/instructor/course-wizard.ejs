  let lessonCounter = 1;
  function addLessonRow() {
    lessonCounter++;
    const idx = lessonCounter - 1;
    const html = `<div class="p-3 bg-white rounded-3 border mb-3 lesson-row-card">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="badge bg-primary rounded-pill px-3 py-1 font-weight-bold">Video Lesson ${lessonCounter}</span>
      </div>
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label small font-weight-semibold">Lesson Title <span class="text-danger">*</span></label>
          <input type="text" name="lesson_title" class="form-control rounded-3" placeholder="e.g. Lesson ${lessonCounter}: Detailed Video Lecture Title" required>
        </div>
        <div class="col-md-4">
          <label class="form-label small font-weight-semibold">Lesson Duration (Minutes)</label>
          <input type="number" name="duration_minutes" class="form-control rounded-3" value="15">
        </div>
        <div class="col-md-6">
          <label class="form-label small font-weight-semibold text-primary"><i class="ri-upload-cloud-2-line me-1"></i> Upload MP4 Lesson Video File</label>
          <input type="file" name="video_file_${idx}" class="form-control rounded-3" accept="video/mp4,video/webm">
          <span class="text-muted small d-block mt-1">Upload MP4 video for Lesson ${lessonCounter}.</span>
        </div>
        <div class="col-md-6">
          <label class="form-label small font-weight-semibold text-secondary"><i class="ri-link me-1"></i> Or Enter Video Stream URL</label>
          <input type="text" name="video_url" class="form-control rounded-3" value="/videos/stream/anat-m1-l${lessonCounter}">
        </div>
        <div class="col-md-6">
          <label class="form-label small font-weight-semibold text-danger"><i class="ri-file-pdf-2-line me-1"></i> Upload PDF Study Notes / Handout Document</label>
          <input type="file" name="pdf_file_${idx}" class="form-control rounded-3" accept=".pdf,.doc,.docx,.ppt,.pptx">
          <span class="text-muted small d-block mt-1">Attach PDF study guide for Lesson ${lessonCounter}.</span>
        </div>
        <div class="col-md-6">
          <label class="form-label small font-weight-semibold text-secondary"><i class="ri-drive-line me-1"></i> Or Enter PDF Link / Google Drive URL</label>
          <input type="text" name="pdf_url" class="form-control rounded-3" placeholder="https://drive.google.com/...">
        </div>
        <div class="col-12">
          <label class="form-label small font-weight-semibold">In-Built Study Notes & Key Points</label>
          <textarea name="lesson_notes" rows="2" class="form-control rounded-3" placeholder="Notes for Lesson ${lessonCounter}..."></textarea>
        </div>
      </div>
    </div>`;
    document.getElementById('lessonsContainer').insertAdjacentHTML('beforeend', html);
  }

  // DYNAMIC ACADEMIC YEAR -> DEPENDENT SUBJECT CATEGORY FILTERING
  function filterSubjectsByYear(selectedYearValue) {
    let yearNum = "1";
    if (selectedYearValue.includes("1") || selectedYearValue === "1") yearNum = "1";
    else if (selectedYearValue.includes("2") || selectedYearValue === "2") yearNum = "2";
    else if (selectedYearValue.includes("3") || selectedYearValue === "3") yearNum = "3";
    else if (selectedYearValue.includes("4") || selectedYearValue === "4") yearNum = "4";
    else yearNum = "other";

    const subjectSelect = document.getElementById('subjectCategorySelector');
    if (!subjectSelect) return;

    const options = subjectSelect.querySelectorAll('option');
    let firstVisible = null;

    options.forEach(opt => {
      const optYear = opt.getAttribute('data-year');
      if (yearNum === 'other') {
        if (optYear === 'null' || optYear === 'other' || !optYear || optYear === '0') {
          opt.style.display = '';
          if (!firstVisible) firstVisible = opt;
        } else {
          opt.style.display = 'none';
        }
      } else {
        if (optYear == yearNum) {
          opt.style.display = '';
          if (!firstVisible) firstVisible = opt;
        } else {
          opt.style.display = 'none';
        }
      }
    });

    if (subjectSelect.selectedOptions.length > 0 && subjectSelect.selectedOptions[0].style.display === 'none') {
      if (firstVisible) {
        subjectSelect.value = firstVisible.value;
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const yearSelect = document.getElementById('yearSelector');
    if (yearSelect) {
      filterSubjectsByYear(yearSelect.value);
    }
  });
</script>
