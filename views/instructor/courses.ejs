<div class="card border-0 shadow-sm rounded-4 overflow-hidden border">
  <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center flex-wrap gap-3 border-bottom">
    <div>
      <h4 class="fw-bold text-dark mb-1"><i class="ri-book-open-line text-primary me-2"></i>Instructor Course Management</h4>
      <p class="text-secondary small mb-0">Create, edit, preview, and publish your professional BPT & MPT courses using the step-by-step wizard.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/instructor/courses/wizard" class="btn btn-primary rounded-pill px-4 py-2 font-weight-bold shadow-sm d-flex align-items-center gap-2" style="background: #0a5dc2; border-color: #0a5dc2;">
        <i class="ri-add-circle-fill fs-5"></i> + Create New Course Wizard
      </a>
    </div>
  </div>
  
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light">
        <tr>
          <th class="ps-4">Course Title</th>
          <th>Subject Category</th>
          <th>Status</th>
          <th>Level</th>
          <th>Students</th>
          <th>Rating</th>
          <th class="text-end pe-4">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (courses.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center text-muted py-5">
              <i class="ri-folder-open-line display-4 opacity-50"></i>
              <p class="mt-2 mb-3">You haven't created any courses yet.</p>
              <a href="/instructor/courses/wizard" class="btn btn-sm btn-primary rounded-pill px-4 font-weight-bold" style="background: #0a5dc2;">
                <i class="ri-add-line me-1"></i> Create Your First Course
              </a>
            </td>
          </tr>
        <% } %>
        <% courses.forEach(c => { %>
          <tr>
            <td class="ps-4">
              <div class="d-flex align-items-center gap-3">
                <img src="<%= c.thumbnail || '/images/courses/course-placeholder.jpg' %>" class="rounded-3 shadow-sm" style="width: 54px; height: 38px; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(c.title) %>&background=0a5dc2&color=fff'">
                <div>
                  <h6 class="fw-bold text-dark mb-0 line-clamp-1"><%= c.title %></h6>
                  <span class="text-muted small"><%= c.target_exam || 'BPT Course' %></span>
                </div>
              </div>
            </td>
            <td><span class="badge bg-primary-subtle text-primary font-weight-bold px-2.5 py-1 rounded-pill"><%= c.category_name || 'General' %></span></td>
            <td>
              <span class="badge <%= c.status === 'published' ? 'bg-success text-white' : 'bg-warning text-dark' %> font-weight-bold px-2.5 py-1 rounded-pill">
                <%= c.status === 'published' ? 'Published' : 'Draft' %>
              </span>
            </td>
            <td><span class="badge bg-light text-dark border font-weight-medium px-2.5 py-1 rounded-pill"><%= c.level || 'Beginner' %></span></td>
            <td class="fw-bold text-dark"><i class="ri-group-line me-1 text-primary"></i> <%= c.students_count || 0 %></td>
            <td><span class="text-warning font-weight-bold"><i class="ri-star-fill me-1"></i> <%= (c.rating_avg || 5.0).toFixed(1) %></span></td>
            <td class="text-end pe-4">
              <div class="d-inline-flex align-items-center gap-1.5">
                <a href="/instructor/courses/wizard?courseId=<%= c.id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3 font-weight-semibold">
                  <i class="ri-magic-line me-1"></i> Edit Wizard
                </a>
                
                <a href="/courses/<%= c.slug %>" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-2.5" title="Preview Course">
                  <i class="ri-eye-line"></i>
                </a>

                <form action="/instructor/courses/<%= c.id %>/publish" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-sm <%= c.status === 'published' ? 'btn-outline-warning' : 'btn-outline-success' %> rounded-pill px-2.5" title="<%= c.status === 'published' ? 'Unpublish' : 'Publish Now' %>">
                    <i class="<%= c.status === 'published' ? 'ri-pause-circle-line' : 'ri-rocket-line' %>"></i>
                  </button>
                </form>

                <form action="/instructor/courses/<%= c.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this course permanently?')">
                  <button class="btn btn-sm btn-outline-danger rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Delete Course">
                    <i class="ri-delete-bin-line"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
