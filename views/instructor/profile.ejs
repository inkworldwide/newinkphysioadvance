<div class="row g-4">
  <div class="col-lg-4">
    <div class="card p-4 text-center">
      <img src="<%= currentUser.avatar %>" class="rounded-circle mx-auto mb-3" style="width:6rem;height:6rem;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(currentUser.name) %>&background=0a5dc2&color=fff&size=128'">
      <h5 class="mb-0"><%= currentUser.name %></h5>
      <p class="text-muted-pe small"><%= currentUser.email %></p>
      <span class="badge badge-soft-primary text-capitalize">Instructor</span>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card p-4">
      <h6 class="mb-3">Profile Information</h6>
      <form action="/profile" method="POST">
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Full Name</label><input type="text" name="name" class="form-control" value="<%= currentUser.name %>"></div>
          <div class="col-md-6"><label class="form-label">Headline</label><input type="text" name="headline" class="form-control" placeholder="e.g. BPT, MPT (Sports Physiotherapy)"></div>
          <div class="col-12"><label class="form-label">Bio</label><textarea name="bio" rows="4" class="form-control"></textarea></div>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Save Changes</button>
      </form>
    </div>
  </div>
</div>
