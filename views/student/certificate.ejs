<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Certificate of Completion | PhysioEdvance</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { background: var(--pe-body-bg); padding: 2.5rem 1rem; }
    .pe-cert {
      max-width: 900px; margin: 0 auto; background: #fff;
      border: 10px solid var(--pe-primary); border-radius: 0.5rem;
      padding: 3.5rem 3rem; text-align: center; position: relative;
    }
    .pe-cert::before {
      content: ''; position: absolute; inset: 18px;
      border: 1px solid #d8deef; border-radius: 0.3rem; pointer-events: none;
    }
    .pe-cert-seal {
      width: 90px; height: 90px; border-radius: 50%;
      background: linear-gradient(135deg, var(--pe-primary), #6c7fc9);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 2.5rem; margin: 0 auto 1.5rem;
    }
    .pe-cert-name { font-family: var(--pe-font-display); font-size: 2.25rem; font-weight: 800; color: var(--pe-heading); margin: 1rem 0; }
    .pe-cert-course { font-size: 1.2rem; font-weight: 700; color: var(--pe-primary); }
    .no-print { margin-top: 2rem; }
    @media print { .no-print { display: none; } body { padding: 0; background: #fff; } .pe-cert { border-width: 6px; } }
  </style>
</head>
<body>
  <div class="pe-cert">
    <div class="pe-cert-seal"><i class="ri-medal-line"></i></div>
    <p class="text-uppercase text-muted-pe small fw-bold" style="letter-spacing:0.1em;">Certificate of Completion</p>
    <p class="text-muted-pe mb-0">This certifies that</p>
    <div class="pe-cert-name"><%= cert.student_name %></div>
    <p class="text-muted-pe mb-2">has successfully completed the course</p>
    <div class="pe-cert-course">"<%= cert.course_title %>"</div>
    <p class="text-muted-pe mt-4 mb-0">Issued on <%= new Date(cert.issued_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p class="text-muted-pe small">Certificate ID: <%= cert.certificate_code %></p>
    <div class="d-flex justify-content-between align-items-end mt-5 pt-4 border-top">
      <div class="text-start">
        <div class="fw-bold" style="font-family: var(--pe-font-display);">PhysioEdvance</div>
        <div class="small text-muted-pe">Online Medical Learning Platform</div>
      </div>
      <div class="pe-brand-icon"><i class="ri-pulse-line"></i></div>
    </div>
  </div>
  <div class="text-center no-print">
    <button class="btn btn-primary" onclick="window.print()"><i class="ri-printer-line me-1"></i> Print / Save as PDF</button>
    <a href="/dashboard" class="btn btn-outline-primary ms-2">Back to Dashboard</a>
  </div>
</body>
</html>
