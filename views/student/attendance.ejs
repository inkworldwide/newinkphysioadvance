<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mark Attendance | PhysioEdvance</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { background: var(--pe-body-bg); }
    .pe-cam-wrapper { position: relative; width: 100%; max-width: 480px; margin: 0 auto; border-radius: var(--pe-radius-lg); overflow: hidden; background: #000; aspect-ratio: 4/3; }
    .pe-cam-wrapper video, .pe-cam-wrapper canvas { width: 100%; height: 100%; object-fit: cover; }
    .pe-cam-wrapper canvas { display: none; }
    .pe-cam-frame-guide { position: absolute; inset: 12%; border: 3px dashed rgba(255,255,255,0.5); border-radius: 50%; pointer-events: none; }
  </style>
</head>
<body>
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-7">

        <div class="text-center mb-4">
          <a href="/courses/<%= course.slug %>/learn" class="small text-muted-pe"><i class="ri-arrow-left-line"></i> Back to course</a>
          <h3 class="mt-2 mb-1">Mark Attendance — <%= course.title %></h3>
        </div>

        <% if (!faceConfigured) { %>
          <div class="alert alert-warning">
            <i class="ri-error-warning-line me-1"></i>
            The face attendance service isn't running or configured yet. The site admin needs to start the
            <code>face-auth-service</code> and set <code>FACE_SERVICE_URL</code> / <code>FACE_SERVICE_SECRET</code> in <code>.env</code>.
          </div>

        <% } else if (alreadyMarkedToday) { %>
          <div class="card p-4 text-center">
            <i class="ri-checkbox-circle-fill text-success" style="font-size:3rem;"></i>
            <h5 class="mt-3">Attendance already marked for today</h5>
            <p class="text-muted-pe small">Come back tomorrow's session to mark attendance again.</p>
            <a href="/courses/<%= course.slug %>/learn" class="btn btn-primary mt-2">Back to Course</a>
          </div>

        <% } else { %>
          <div class="card p-4">
            <div class="pe-cam-wrapper mb-3">
              <video id="video" autoplay playsinline></video>
              <canvas id="canvas"></canvas>
              <div class="pe-cam-frame-guide"></div>
            </div>

            <p class="text-center small text-muted-pe mb-3" id="statusText">
              <% if (isRegistered) { %>
                Position your face in the frame, then tap "Scan & Mark Attendance".
              <% } else { %>
                You haven't registered your face yet. We'll register it now, then mark today's attendance.
              <% } %>
            </p>

            <div class="d-flex gap-2 justify-content-center">
              <button id="captureBtn" class="btn btn-primary btn-lg">
                <i class="ri-camera-line me-1"></i>
                <%= isRegistered ? 'Scan & Mark Attendance' : 'Register Face & Mark Attendance' %>
              </button>
            </div>

            <div id="resultBox" class="mt-3"></div>
          </div>

          <div class="alert alert-light border mt-3 small">
            <i class="ri-shield-check-line me-1"></i>
            Your photo is processed to create a numeric face signature and is not stored as an image.
            See the <a href="#" data-bs-toggle="modal" data-bs-target="#privacyModal">privacy details</a>.
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Privacy modal -->
  <div class="modal fade" id="privacyModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header"><h6 class="modal-title">How your face data is used</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body small">
          <p>When you register, your photo is converted into a numeric "face signature" (128 numbers) and the original photo is discarded immediately — it is never saved to disk.</p>
          <p>When you scan to mark attendance, a new signature is computed and compared mathematically to your stored one. Only a match/no-match result and a similarity score are saved — not any image.</p>
          <p class="mb-0">You can ask your instructor or admin to delete your stored face data at any time.</p>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const video = document.getElementById('video');
    const canvas = document.getElementById('canvas');
    const captureBtn = document.getElementById('captureBtn');
    const resultBox = document.getElementById('resultBox');
    const statusText = document.getElementById('statusText');
    const isRegistered = <%= isRegistered ? 'true' : 'false' %>;
    const courseId = <%= course.id %>;

    let stream;

    async function startCamera() {
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
        video.srcObject = stream;
      } catch (err) {
        resultBox.innerHTML = '<div class="alert alert-danger">Could not access your camera. Please allow camera permission and reload.</div>';
        captureBtn.disabled = true;
      }
    }
    startCamera();

    function captureFrame() {
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL('image/jpeg', 0.9);
    }

    captureBtn.addEventListener('click', async () => {
      captureBtn.disabled = true;
      const originalText = captureBtn.innerHTML;
      captureBtn.innerHTML = '<i class="ri-loader-4-line"></i> Processing...';
      resultBox.innerHTML = '';

      const imageData = captureFrame();

      try {
        if (!isRegistered) {
          const regRes = await fetch('/attendance/register-face', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: imageData })
          });
          const regData = await regRes.json();
          if (!regData.success) {
            resultBox.innerHTML = `<div class="alert alert-danger">${regData.message || 'Could not register your face.'}</div>`;
            captureBtn.disabled = false; captureBtn.innerHTML = originalText;
            return;
          }
        }

        const verifyRes = await fetch('/attendance/verify', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ image: imageData, courseId })
        });
        const verifyData = await verifyRes.json();

        if (verifyData.success && verifyData.match) {
          resultBox.innerHTML = `<div class="alert alert-success"><i class="ri-checkbox-circle-fill me-1"></i> Attendance marked successfully!</div>`;
          captureBtn.style.display = 'none';
          statusText.textContent = 'See you in the next session.';
          if (stream) stream.getTracks().forEach(t => t.stop());
        } else if (verifyData.success && !verifyData.match) {
          resultBox.innerHTML = `<div class="alert alert-warning">Face didn't match closely enough (distance: ${verifyData.distance}). Try again with better lighting, facing the camera directly.</div>`;
          captureBtn.disabled = false; captureBtn.innerHTML = originalText;
        } else {
          resultBox.innerHTML = `<div class="alert alert-danger">${verifyData.message || 'Something went wrong.'}</div>`;
          captureBtn.disabled = false; captureBtn.innerHTML = originalText;
        }
      } catch (err) {
        resultBox.innerHTML = `<div class="alert alert-danger">Network error. Please try again.</div>`;
        captureBtn.disabled = false; captureBtn.innerHTML = originalText;
      }
    });
  </script>
</body>
</html>
