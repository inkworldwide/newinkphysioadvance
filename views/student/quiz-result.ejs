<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz Results | PhysioEdvance</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/learn.css">
</head>
<body class="pe-learn-body">

  <div class="pe-learn-topbar">
    <a href="/courses/<%= courseSlug %>/learn" class="pe-learn-back"><i class="ri-arrow-left-line"></i> Back to course</a>
  </div>

  <div class="pe-learn-main">
    <div class="pe-learn-content">

      <div class="card p-4 mb-4 text-center">
        <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
             style="width:5rem;height:5rem;background:<%= result.passed ? 'rgba(10,179,156,.12)' : 'rgba(240,101,72,.12)' %>;">
          <i class="<%= result.passed ? 'ri-trophy-line text-success' : 'ri-emotion-sad-line text-danger' %>" style="font-size:2.25rem;"></i>
        </div>
        <h3 class="mb-1"><%= result.passed ? 'Great job, you passed!' : 'Not quite there yet' %></h3>
        <p class="text-muted-pe mb-3">You scored <%= result.correct %> out of <%= result.total %> questions correctly.</p>
        <h1 class="mb-0"><%= result.score %>%</h1>
        <p class="text-muted-pe small">Pass mark: <%= result.passPercentage %>%</p>
        <div class="d-flex gap-2 justify-content-center mt-3">
          <a href="/courses/<%= courseSlug %>/learn?lesson=<%= lessonId %>" class="btn btn-outline-primary">Retake Quiz</a>
          <a href="/courses/<%= courseSlug %>/learn" class="btn btn-primary">Continue Course</a>
        </div>
      </div>

      <h5 class="mb-3">Review Your Answers</h5>
      <% result.detailed.forEach((q, idx) => { %>
        <div class="card p-4 mb-3">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="mb-0"><%= idx + 1 %>. <%= q.question %></h6>
            <span class="badge <%= q.isCorrect ? 'badge-soft-success' : 'badge-soft-danger' %> flex-shrink-0 ms-2">
              <%= q.isCorrect ? 'Correct' : 'Incorrect' %>
            </span>
          </div>
          <div class="d-flex flex-column gap-2 mt-2">
            <% ['a','b','c','d'].forEach(opt => { %>
              <div class="pe-quiz-option" style="cursor:default;
                <% if (opt === q.correct_option) { %> border-color: var(--pe-success); background: rgba(10,179,156,.06); <% } %>
                <% if (opt === q.selected && !q.isCorrect) { %> border-color: var(--pe-danger); background: rgba(240,101,72,.06); <% } %>">
                <span><%= q['option_' + opt] %></span>
                <% if (opt === q.correct_option) { %><i class="ri-checkbox-circle-fill text-success ms-auto"></i><% } %>
                <% if (opt === q.selected && opt !== q.correct_option) { %><i class="ri-close-circle-fill text-danger ms-auto"></i><% } %>
              </div>
            <% }) %>
          </div>
          <% if (q.explanation) { %>
            <div class="alert alert-light border mt-3 mb-0 small"><i class="ri-lightbulb-line me-1"></i> <%= q.explanation %></div>
          <% } %>
        </div>
      <% }) %>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
