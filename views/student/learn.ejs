<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= currentLesson ? currentLesson.title : course.title %> | PhysioEdvance</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/learn.css">
</head>
<body class="pe-learn-body">

  <div class="pe-learn-topbar">
    <a href="/courses/<%= course.slug %>" class="pe-learn-back"><i class="ri-arrow-left-line"></i> <span class="d-none d-md-inline">Back to course</span></a>
    <span class="pe-learn-title d-none d-md-inline"><%= course.title %></span>
    <div class="d-flex align-items-center gap-3 ms-auto">
      <a href="/subjects/<%= course.category_slug || 'anatomy' %>/course" class="btn btn-sm btn-warning rounded-pill font-weight-bold shadow-sm d-none d-sm-inline-flex align-items-center gap-1" style="background-color: #f59e0b !important; color: #000; border: none;">
        <i class="ri-box-3-line"></i> 3D Course Platform
      </a>
      <div class="pe-learn-progress d-none d-sm-flex align-items-center gap-2">
        <div class="progress" style="width:120px;"><div class="progress-bar" style="width:<%= enrollment ? enrollment.progress_percent : 0 %>%"></div></div>
        <span class="small text-muted-pe"><%= enrollment ? Math.round(enrollment.progress_percent) : 0 %>%</span>
      </div>
      <button class="pe-learn-toggle-sidebar" id="learnSidebarToggle"><i class="ri-menu-line"></i></button>
    </div>
  </div>

  <div class="pe-learn-wrapper">
    <div class="pe-learn-main">
      <% if (!currentLesson) { %>
        <div class="text-center py-5">
          <i class="ri-folder-open-line" style="font-size:3rem;color:var(--pe-text-muted);"></i>
          <p class="text-muted-pe mt-2">This course doesn't have any lessons yet.</p>
        </div>
      <% } else if (quiz) { %>
        <!-- ===== QUIZ VIEW ===== -->
        <div class="pe-learn-content">
          <h3 class="mb-1"><%= quiz.title %></h3>
          <p class="text-muted-pe mb-4"><%= quiz.description %> &middot; Pass mark: <%= quiz.pass_percentage %>% &middot; <%= questions.length %> questions</p>

          <form action="/quiz/submit" method="POST" id="quizForm">
            <input type="hidden" name="quizId" value="<%= quiz.id %>">
            <input type="hidden" name="courseSlug" value="<%= course.slug %>">
            <input type="hidden" name="lessonId" value="<%= currentLesson.id %>">

            <% questions.forEach((q, idx) => { %>
              <div class="card p-4 mb-3">
                <h6 class="mb-3"><%= idx + 1 %>. <%= q.question %></h6>
                <div class="d-flex flex-column gap-2">
                  <% ['a','b','c','d'].forEach(opt => { %>
                    <label class="pe-quiz-option">
                      <input type="radio" name="q_<%= q.id %>" value="<%= opt %>" required>
                      <span><%= q['option_' + opt] %></span>
                    </label>
                  <% }) %>
                </div>
              </div>
            <% }) %>

            <button type="submit" class="btn btn-primary btn-lg w-100">Submit Quiz</button>
          </form>
        </div>
      <% } else { %>
        <!-- ===== INTERNAL PHYSIOEDVANCE VIDEO & ARTICLE VIEW ===== -->
        <div class="pe-learn-content">
          
          <!-- Auto-Resume Toast Banner -->
          <div id="resumeToast" class="alert alert-primary mb-3 d-none align-items-center justify-content-between rounded-4 shadow-sm">
            <span><i class="ri-time-line me-1"></i> Welcome back! Resuming video from <strong id="resumeTimeStr">00:00</strong>...</span>
            <button type="button" class="btn-close small" onclick="document.getElementById('resumeToast').classList.add('d-none')"></button>
          </div>

          <!-- Internal Video Player -->
          <% const videoSrc = (currentLesson.video_url && !currentLesson.video_url.includes('youtube')) ? currentLesson.video_url : ('/videos/stream/' + (course.category_slug || 'anatomy') + '-intro'); %>
          <div class="card border-0 rounded-4 overflow-hidden shadow-lg mb-4 bg-dark">
            <div class="ratio ratio-16x9 bg-dark">
              <video id="peVideoPlayer" playsinline controls class="w-100 h-100" style="object-fit: cover; background: #020617;">
                <source src="<%= videoSrc %>" type="video/mp4">
                Your browser does not support HTML5 video playback.
              </video>
            </div>

            <!-- Custom Control Bar -->
            <div class="card-body p-3 bg-dark text-white d-flex align-items-center justify-content-between flex-wrap gap-2 border-top border-secondary border-opacity-25">
              <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:36px; height:36px;" onclick="seekRelative(-10)">
                  <i class="ri-replay-10-line fs-6"></i>
                </button>
                <button type="button" class="btn btn-sm btn-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:36px; height:36px;" onclick="seekRelative(10)">
                  <i class="ri-forward-10-line fs-6"></i>
                </button>
                <span class="badge bg-warning text-dark font-weight-bold px-2.5 py-1 rounded-pill small ms-2">
                  <i class="ri-shield-check-fill me-1 text-primary"></i> PhysioEdvance Internal Player
                </span>
              </div>

              <!-- Speed Selector -->
              <div class="d-flex align-items-center gap-2">
                <span class="small text-white-75"><i class="ri-speed-line me-1"></i> Speed:</span>
                <select class="form-select form-select-sm bg-dark text-white border-secondary rounded-pill w-auto small" onchange="if(document.getElementById('peVideoPlayer')) document.getElementById('peVideoPlayer').playbackRate = parseFloat(this.value)">
                  <option value="0.5">0.5x</option>
                  <option value="0.75">0.75x</option>
                  <option value="1.0" selected>1.0x (Normal)</option>
                  <option value="1.25">1.25x</option>
                  <option value="1.5">1.5x</option>
                  <option value="2.0">2.0x</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Lesson Title & Description -->
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4 border">
            <h3 class="fw-bold text-dark mb-2"><%= currentLesson.title %></h3>
            <p class="text-secondary leading-relaxed mb-0"><%= currentLesson.description || 'Comprehensive physiotherapy lecture note and practical demonstration.' %></p>
          </div>

          <!-- Structured Lesson Notes -->
          <% if (currentLesson.content) { %>
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4">
              <h5 class="fw-bold text-dark mb-3 border-bottom pb-2"><i class="ri-file-text-line text-primary me-2"></i>Structured Lesson Notes</h5>
              <div class="pe-notes-body text-dark leading-relaxed" style="line-height: 1.7;"><%- currentLesson.content %></div>
            </div>
          <% } %>

          <!-- 💡 Key Points Callout -->
          <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 border" style="background: linear-gradient(135deg, #fffbe6 0%, #fef3c7 100%); border-left: 5px solid #f59e0b !important;">
            <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
              <i class="ri-lightbulb-fill text-warning fs-4"></i>
              <span class="fs-5">💡 Key Exam & Clinical Points</span>
            </div>
            <ul class="list-unstyled mb-0">
              <li class="small text-dark mb-1.5 d-flex align-items-center"><i class="ri-checkbox-circle-fill text-warning me-2"></i> Focus on anatomical bony landmarks & nerve supply during evaluation.</li>
              <li class="small text-dark mb-1.5 d-flex align-items-center"><i class="ri-checkbox-circle-fill text-warning me-2"></i> Apply progressive overload principles respecting biological tissue healing phases.</li>
              <li class="small text-dark mb-0 d-flex align-items-center"><i class="ri-checkbox-circle-fill text-warning me-2"></i> Integrate clinical outcome measures to monitor long-term patient progress.</li>
            </ul>
          </div>

          <!-- Complete Course Platform Action Button -->
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white mb-4" style="background: linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%) !important;">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
              <div>
                <h5 class="fw-bold text-white mb-1"><i class="ri-box-3-line text-warning me-2"></i>Explore 3D Models, Flashcards & Clinical Cases</h5>
                <p class="text-white-75 small mb-0">Open the complete 3D interactive course environment for <%= course.category_name || 'this subject' %>.</p>
              </div>
              <a href="/subjects/<%= course.category_slug || 'anatomy' %>/course" class="btn btn-warning rounded-pill px-4 py-2 font-weight-bold text-dark shadow-sm" style="background-color: #f59e0b !important; border: none;">
                Open 3D Course Platform <i class="ri-arrow-right-line ms-1"></i>
              </a>
            </div>
          </div>

          <!-- Lesson Progress Bar & Mark Complete -->
          <div class="pe-learn-footer d-flex align-items-center justify-content-between flex-wrap gap-3 mt-4 pt-3 border-top">
            <% if (prevLesson) { %>
              <a href="/courses/<%= course.slug %>/learn?lesson=<%= prevLesson.id %>" class="btn btn-outline-secondary rounded-pill px-3.5"><i class="ri-arrow-left-line me-1"></i> Previous Lesson</a>
            <% } else { %>
              <div></div>
            <% } %>

            <form action="/courses/<%= course.slug %>/lessons/<%= currentLesson.id %>/complete" method="POST">
              <button type="submit" class="btn btn-success rounded-pill px-4 font-weight-bold shadow-sm">
                <i class="ri-checkbox-circle-line me-1"></i> Mark as Completed
              </button>
            </form>

            <% if (nextLesson) { %>
              <a href="/courses/<%= course.slug %>/learn?lesson=<%= nextLesson.id %>" class="btn btn-primary rounded-pill px-3.5 font-weight-bold" style="background: #0a5dc2; border-color: #0a5dc2;">Next Lesson <i class="ri-arrow-right-line ms-1"></i></a>
            <% } %>
          </div>

        </div>
      <% } %>
    </div>

    <!-- Sidebar Navigation -->
    <div class="pe-learn-sidebar" id="learnSidebar">
      <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
        <h6 class="fw-bold mb-0">Course Content</h6>
        <button class="btn btn-sm btn-icon border-0 text-muted-pe" id="learnSidebarClose"><i class="ri-close-line"></i></button>
      </div>

      <div class="accordion accordion-flush" id="sidebarAccordion">
        <% modules.forEach((mod, mIdx) => { %>
          <div class="accordion-item border-0">
            <h2 class="accordion-header">
              <button class="accordion-button <%= (currentLesson && mod.lessons.some(l => l.id === currentLesson.id)) ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMod<%= mod.id %>">
                <div class="d-flex flex-column text-start">
                  <span class="fw-bold text-dark small">Module <%= mIdx + 1 %>: <%= mod.title %></span>
                  <span class="text-muted-pe small font-normal" style="font-size:0.75rem;"><%= mod.lessons.length %> lessons</span>
                </div>
              </button>
            </h2>
            <div id="sidebarMod<%= mod.id %>" class="accordion-collapse collapse <%= (currentLesson && mod.lessons.some(l => l.id === currentLesson.id)) ? 'show' : '' %>" data-bs-parent="#sidebarAccordion">
              <div class="list-group list-group-flush">
                <% mod.lessons.forEach(l => { %>
                  <a href="/courses/<%= course.slug %>/learn?lesson=<%= l.id %>" class="list-group-item list-group-item-action border-0 py-2.5 px-3 small d-flex align-items-center justify-content-between <%= (currentLesson && currentLesson.id === l.id) ? 'bg-primary text-white font-weight-bold' : '' %>">
                    <span class="line-clamp-1"><%= l.title %></span>
                    <i class="ri-play-circle-line ms-1"></i>
                  </a>
                <% }) %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const videoPlayer = document.getElementById('peVideoPlayer');
    const storageKey = `watch_pos_<%= course.slug %>_<%= currentLesson ? currentLesson.id : '0' %>`;

    document.addEventListener('DOMContentLoaded', () => {
      const savedPos = localStorage.getItem(storageKey);
      if (savedPos && videoPlayer) {
        const posSec = parseFloat(savedPos);
        if (posSec > 5) {
          videoPlayer.currentTime = posSec;
          const mins = Math.floor(posSec / 60);
          const secs = Math.floor(posSec % 60);
          const timeStr = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
          
          const toast = document.getElementById('resumeToast');
          document.getElementById('resumeTimeStr').innerText = timeStr;
          if (toast) toast.classList.remove('d-none');
        }
      }

      const sidebarToggle = document.getElementById('learnSidebarToggle');
      const sidebarClose = document.getElementById('learnSidebarClose');
      const sidebar = document.getElementById('learnSidebar');
      if (sidebarToggle && sidebar) sidebarToggle.addEventListener('click', () => sidebar.classList.toggle('show'));
      if (sidebarClose && sidebar) sidebarClose.addEventListener('click', () => sidebar.classList.remove('show'));
    });

    if (videoPlayer) {
      videoPlayer.addEventListener('timeupdate', () => {
        if (videoPlayer.currentTime > 2) {
          localStorage.setItem(storageKey, videoPlayer.currentTime);
        }
      });
    }

    function seekRelative(seconds) {
      if (videoPlayer) {
        videoPlayer.currentTime = Math.max(0, Math.min(videoPlayer.duration || 100, videoPlayer.currentTime + seconds));
      }
    }
  </script>
</body>
</html>
