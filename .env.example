PORT=3000
SESSION_SECRET=physico_edvance_super_secret_change_this_in_production
NODE_ENV=development

# PostgreSQL connection (local install — see README for setup steps)
# Create the database first: `createdb physioedvance` (or via pgAdmin/psql)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=physioedvance

# Razorpay (get real keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Face attendance microservice (optional feature — see face-auth-service/README.md)
# Leave blank to disable; the attendance page will show a clear "not configured" notice.
FACE_SERVICE_URL=http://localhost:8001
FACE_SERVICE_SECRET=

# Zoom (Server-to-Server OAuth app — https://marketplace.zoom.us/)
# Used for real Live Classes / Workshops / Webinars / Panel Discussions.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# SMS notifications via MSG91 (https://msg91.com) — requires DLT sender-ID
# registration in India before you can send real SMS. See README.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PHYEDV
