# Shared secret — must match FACE_SERVICE_SECRET used by the Node app's .env
FACE_SERVICE_SECRET=generate_a_long_random_string_here

# How strict face matching is (0.0 = must be near-identical, 1.0 = very loose).
# 0.4-0.5 is a reasonable starting point; tune based on real test results.
FACE_MATCH_TOLERANCE=0.5

FACE_STORAGE_DIR=storage/face_encodings
FACE_SERVICE_HOST=0.0.0.0
FACE_SERVICE_PORT=8001
FACE_RATE_LIMIT_PER_MINUTE=10
